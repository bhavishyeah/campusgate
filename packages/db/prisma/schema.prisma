generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ΓöÇΓöÇΓöÇ ENUMS ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

enum UserRole {
  STUDENT
  HOD
  GUARD
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  PENDING_APPROVAL
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum PassStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  OUTSIDE
  COMPLETED
  CANCELLED
  EXPIRED
  REVOKED
}

enum GateEventType {
  EXIT
  RETURN
}

enum AuditAction {
  PASS_REQUESTED
  PASS_APPROVED
  PASS_REJECTED
  PASS_CANCELLED
  PASS_REVOKED
  PASS_EXPIRED
  GATE_EXIT
  GATE_RETURN
  SHIFT_CREATED
  SHIFT_STARTED
  SHIFT_ENDED
  EMERGENCY_DECLARED
  EMERGENCY_RESOLVED
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  USER_REACTIVATED
  GATE_CREATED
  GATE_UPDATED
  DEPARTMENT_CREATED
  DEPARTMENT_UPDATED
  REASON_CREATED
  REASON_UPDATED
  BULK_IMPORT
  EMERGENCY_OVERRIDE
  ALLOWANCE_POLICY_UPDATED
  INSTITUTION_CONFIG_UPDATED
  ACADEMIC_CALENDAR_UPDATED
}

enum AuditResult {
  SUCCESS
  DENIED
  ERROR
}

enum SupportGrantStatus {
  REQUESTED
  ACTIVE
  EXPIRED
  REVOKED
}

enum PolicyPeriod {
  DAILY
  WEEKLY
  MONTHLY
  SEMESTER
}

enum EnforcementMode {
  BLOCK_NEW_REQUESTS
  WARN_ONLY
}

enum SeverityLevel {
  MINOR
  MODERATE
  SIGNIFICANT
  SEVERE
}

enum InstitutionStatus {
  ACTIVE
  SUSPENDED
}

enum ModuleState {
  ENTITLED
  ACTIVE
  SUSPENDED
}

// ΓöÇΓöÇΓöÇ ACADEMICS (Phase 1 ΓÇö sessions / terms / programs / calendar) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

enum AcademicSessionStatus {
  UPCOMING
  ACTIVE
  CLOSED
}

enum AcademicStructureType {
  SEMESTER
  TRIMESTER
  ANNUAL
  CUSTOM
}

enum AcademicTermStatus {
  UPCOMING
  ACTIVE
  CLOSED
}

enum ProgramStatus {
  ACTIVE
  INACTIVE
}

enum ProgramDurationUnit {
  TERMS
  YEARS
}

enum WeekStartDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AcademicDayType {
  WORKING_DAY
  HOLIDAY
  WEEKEND
  EXAM_DAY
  VACATION
  SPECIAL_WORKING_DAY
  INSTITUTION_EVENT
}

enum GuardShiftStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EmergencyType {
  FIRE
  EARTHQUAKE
  MEDICAL
  SECURITY
  EVACUATION
  OTHER
}

enum EmergencyStatus {
  ACTIVE
  RESOLVED
}

// ΓöÇΓöÇΓöÇ STUDENTS / SIS (Phase 2 ΓÇö student lifecycle, history, documents) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

enum StudentStatus {
  APPLICANT
  ENROLLED
  ACTIVE
  ON_LEAVE
  GRADUATED
  WITHDRAWN
  SUSPENDED
}

enum StudentHistoryChangeType {
  CREATED
  STATUS_CHANGED
  PROGRAM_CHANGED
  ENROLLED
  PROMOTED
  TRANSFERRED
  DEACTIVATED
  UPDATED
}

enum StudentDocumentKind {
  ID_PROOF
  PHOTO
  TRANSCRIPT
  CERTIFICATE
  OTHER
}

// ΓöÇΓöÇΓöÇ INSTITUTION (future multi-tenancy) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model Institution {
  id        String            @id @default(cuid())
  name      String
  code      String            @unique
  domain    String?
  status    InstitutionStatus @default(ACTIVE)
  settings  Json              @default("{}")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  departments        Department[]
  gates              Gate[]
  users              User[]
  exitReasons        ExitReason[]
  allowancePolicy    AllowancePolicy?
  institutionConfig  InstitutionConfig?
  academicCalendarDays AcademicCalendarDay[]
  guardShifts          GuardShift[]
  emergencyAlerts      EmergencyAlert[]
  studentProfiles      StudentProfile[]
  hodProfiles          HodProfile[]
  guardProfiles        GuardProfile[]
  gatePasses           GatePass[]
  gateEvents           GateEvent[]
  guardGateAssignments GuardGateAssignment[]
  emergencyOverrides   EmergencyOverride[]
  reliabilitySnapshots ReliabilityScoreSnapshot[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  memberships          InstitutionMembership[]
  roles                Role[]
  auditEvents          AuditEvent[]
  supportGrants        SupportGrant[]
  institutionModules   InstitutionModule[]
  academicSessions             AcademicSession[]
  academicTerms                AcademicTerm[]
  programs                     Program[]
  academicCalendarDayRevisions AcademicCalendarDayRevision[]
  studentProfileHistory        StudentProfileHistory[]
  studentDocuments             StudentDocument[]
  courses                      Course[]
  subjects                     Subject[]
  classSections                ClassSection[]
  classEnrollments             ClassEnrollment[]
  facultyProfiles              FacultyProfile[]
  facultyAssignments           FacultyAssignment[]
  timetables                   Timetable[]
  scheduledClasses             ScheduledClass[]
  scheduleRevisions            ScheduleRevision[]
  attendanceSessions           AttendanceSession[]
  attendanceRecords            AttendanceRecord[]
  attendanceCorrections        AttendanceCorrection[]
  attendanceRecordHistory      AttendanceRecordHistory[]
  bookTitles                   BookTitle[]
  bookCopies                   BookCopy[]
  libraryLoans                 LibraryLoan[]
  bookReservations             BookReservation[]
  libraryFines                 LibraryFine[]
  admissionCampaigns           AdmissionCampaign[]
  admissionCampaignPrograms    AdmissionCampaignProgram[]
  applications                 Application[]
  applicationDocuments         ApplicationDocument[]
  applicationReviews           ApplicationReview[]
  admissionOffers              AdmissionOffer[]
  enrollments                  Enrollment[]
  feeStructures                FeeStructure[]
  feeComponents                FeeComponent[]
  studentCharges               StudentCharge[]
  paymentTransactions          PaymentTransaction[]
  paymentAllocations           PaymentAllocation[]
  receipts                     Receipt[]
  processedWebhookEvents       ProcessedWebhookEvent[]
  concessionDefinitions        ConcessionDefinition[]
  studentConcessions           StudentConcession[]
  concessionCredits            ConcessionCredit[]
  refunds                      Refund[]
  refundReversals              RefundReversal[]
  adjustments                  Adjustment[]
  examinations                 Examination[]
  gradingSchemes               GradingScheme[]
  gradeBands                   GradeBand[]
  examSchedules                ExamSchedule[]
  candidates                   Candidate[]
  assessments                  Assessment[]
  marksRecords                 MarksRecord[]
  marksRecordHistory           MarksRecordHistory[]
  resultPublications           ResultPublication[]
  resultSnapshots              ResultSnapshot[]
  reevalRequests               ReevalRequest[]
  facultyQualifications        FacultyQualification[]
  facultyWorkloadPolicies      FacultyWorkloadPolicy[]
  facultyWorkloads             FacultyWorkload[]
  facultyTeachingHistory       FacultyTeachingHistory[]
  hrEmployees                  HrEmployee[]
  hrContracts                  HrContract[]
  hrLeavePolicies              HrLeavePolicy[]
  hrLeaveApplications          HrLeaveApplication[]
  hrShifts                     HrShift[]
  hrEmployeeAttendance         HrEmployeeAttendance[]
  hrEmployeeAttendanceHistory  HrEmployeeAttendanceHistory[]
  hostelBuildings              HostelBuilding[]
  hostelRooms                  HostelRoom[]
  hostelRoomAllocations        HostelRoomAllocation[]
  hostelCheckEvents            HostelCheckEvent[]
  hostelLeaveApplications      HostelLeaveApplication[]
  hostelMaintenanceRequests    HostelMaintenanceRequest[]
  transportVehicles                 TransportVehicle[]
  transportDrivers                  TransportDriver[]
  transportRoutes                   TransportRoute[]
  transportRouteStops               TransportRouteStop[]
  transportRouteAssignments         TransportRouteAssignment[]
  transportEnrollments              TransportEnrollment[]
  transportVehicleMaintenanceRequests TransportVehicleMaintenanceRequest[]
  transportRouteSchedules           TransportRouteSchedule[]

  @@map("institutions")
}

// ΓöÇΓöÇΓöÇ DEPARTMENT ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model Department {
  id            String      @id @default(cuid())
  name          String
  code          String
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  students StudentProfile[]
  hods     HodProfile[]
  programs            Program[]
  academicCalendarDays AcademicCalendarDay[]
  facultyProfiles      FacultyProfile[]
  hrEmployees          HrEmployee[]

  @@unique([institutionId, code])
  @@unique([id, institutionId])
  @@map("departments")
}

// ΓöÇΓöÇΓöÇ USER (unified auth) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String?
  googleId      String?       @unique
  role          UserRole
  accountStatus AccountStatus @default(ACTIVE)
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lastLoginAt   DateTime?
  phone            String?
  mfaEnabled       Boolean       @default(false)
  mfaSecret        String?
  mfaRecoveryCodes Json?
  mfaEnrolledAt    DateTime?

  studentProfile StudentProfile?
  hodProfile     HodProfile?
  guardProfile   GuardProfile?

  // Audit trail
  auditLogs          AuditLog[]          @relation("AuditActor")
  emergencyOverrides    EmergencyOverride[] @relation("OverrideActor")
  createdShifts         GuardShift[]        @relation("ShiftCreatedBy")
  createdEmergencyAlerts EmergencyAlert[]   @relation("EmergencyDeclaredBy")
  resolvedEmergencyAlerts EmergencyAlert[]  @relation("EmergencyResolvedBy")
  sessions               Session[]
  securityEvents         SecurityEvent[]
  memberships            InstitutionMembership[]

  // Super Admin & platform security (FEAT-001)
  auditEvents            AuditEvent[]   @relation("AuditEventActor")
  supportGrantsGranted   SupportGrant[] @relation("SupportGrantGrantee")
  supportGrantsRevoked   SupportGrant[] @relation("SupportGrantRevoker")
  facultyProfile         FacultyProfile?
  applications           Application[]  @relation("ApplicationApplicant")
  hrEmployees            HrEmployee[]

  @@unique([id, institutionId])
  @@map("users")
}

// ΓöÇΓöÇΓöÇ IDENTITY & RBAC (B-2) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model InstitutionMembership {
  id                 String           @id @default(cuid())
  userId             String
  institutionId      String
  membershipStatus   MembershipStatus @default(ACTIVE)
  departmentScope    String?
  permissionsVersion Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id])
  institution Institution      @relation(fields: [institutionId], references: [id])
  roles       MembershipRole[]

  @@unique([userId, institutionId])
  @@unique([id, institutionId])
  @@index([institutionId])
  @@index([userId])
  @@map("institution_memberships")
}

model Role {
  id            String           @id @default(cuid())
  key           String
  name          String
  institutionId String?
  institution   Institution?     @relation(fields: [institutionId], references: [id])
  permissions   RolePermission[]
  memberships   MembershipRole[]

  @@unique([key, institutionId])
  @@index([institutionId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  module      String
  description String
  roleLinks   RolePermission[]

  @@index([module])
  @@map("permissions")
}

model MembershipRole {
  id            String                @id @default(cuid())
  membershipId  String
  roleId        String
  institutionId String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  membership InstitutionMembership @relation(fields: [membershipId], references: [id])
  role       Role                  @relation(fields: [roleId], references: [id])

  @@unique([membershipId, roleId])
  @@index([institutionId])
  @@map("membership_roles")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ΓöÇΓöÇΓöÇ STUDENT PROFILE ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model StudentProfile {
  id            String      @id @default(cuid())
  userId        String      @unique
  user          User        @relation(fields: [userId], references: [id])
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  enrollmentNo  String      @unique
  rollNumber    String?
  name          String
  departmentId  String
  department    Department  @relation(fields: [departmentId], references: [id])
  program       String
  semester      Int
  section       String?
  dob           String?
  phone         String?
  address       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Phase 2 SIS generalization ΓÇö all additive-nullable / defaulted so every
  // existing live row stays valid and every live query keeps working.
  status            StudentStatus    @default(ACTIVE)
  admissionDate     DateTime?
  programId         String?
  structuredProgram Program?         @relation(fields: [programId], references: [id])
  academicSessionId String?
  academicSession   AcademicSession? @relation(fields: [academicSessionId], references: [id])
  currentTermId     String?
  currentTerm       AcademicTerm?    @relation(fields: [currentTermId], references: [id])

  gatePasses           GatePass[]
  reliabilitySnapshots ReliabilityScoreSnapshot[]
  history              StudentProfileHistory[]
  documents            StudentDocument[]
  classEnrollments     ClassEnrollment[]
  attendanceRecords    AttendanceRecord[]
  libraryLoans         LibraryLoan[]
  bookReservations     BookReservation[]
  libraryFines         LibraryFine[]
  enrollments          Enrollment[]
  studentCharges       StudentCharge[]
  paymentTransactions  PaymentTransaction[]
  studentConcessions   StudentConcession[]
  refunds              Refund[]
  adjustments          Adjustment[]
  candidates           Candidate[]
  marksRecords         MarksRecord[]
  resultSnapshots      ResultSnapshot[]
  reevalRequests       ReevalRequest[]
  hostelRoomAllocations   HostelRoomAllocation[]
  hostelCheckEvents       HostelCheckEvent[]
  hostelLeaveApplications HostelLeaveApplication[]
  transportEnrollments    TransportEnrollment[]

  @@unique([id, institutionId])
  @@index([institutionId])
  @@index([institutionId, status])
  @@index([institutionId, programId])
  @@map("student_profiles")
}

// ΓöÇΓöÇΓöÇ STUDENT PROFILE HISTORY (Phase 2, tenant-owned, append-only) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model StudentProfileHistory {
  id               String                   @id @default(cuid())
  institutionId    String
  institution      Institution              @relation(fields: [institutionId], references: [id])
  studentProfileId String
  studentProfile   StudentProfile           @relation(fields: [studentProfileId], references: [id])
  changeType       StudentHistoryChangeType

  previousStatus       StudentStatus?
  newStatus            StudentStatus?
  previousProgramId    String?
  newProgramId         String?
  previousProgramText  String?
  newProgramText       String?
  previousSemester     Int?
  newSemester          Int?
  previousDepartmentId String?
  newDepartmentId      String?
  previousSessionId    String?
  newSessionId         String?
  previousTermId       String?
  newTermId            String?

  actorUserId       String
  actorMembershipId String?
  reason            String?
  metadata          Json?
  createdAt         DateTime @default(now())

  @@unique([id, institutionId])
  @@index([institutionId])
  @@index([institutionId, studentProfileId])
  @@index([studentProfileId])
  @@map("student_profile_history")
}

// ΓöÇΓöÇΓöÇ STUDENT DOCUMENT (Phase 2, tenant-owned, reference metadata only) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model StudentDocument {
  id               String              @id @default(cuid())
  institutionId    String
  institution      Institution         @relation(fields: [institutionId], references: [id])
  studentProfileId String
  studentProfile   StudentProfile      @relation(fields: [studentProfileId], references: [id])
  kind             StudentDocumentKind @default(OTHER)
  title            String
  storageKey       String
  contentType      String?
  sizeBytes        Int?
  uploadedByUserId String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([id, institutionId])
  @@index([institutionId])
  @@index([institutionId, studentProfileId])
  @@map("student_documents")
}

// ΓöÇΓöÇΓöÇ HOD PROFILE ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model HodProfile {
  id            String      @id @default(cuid())
  userId        String      @unique
  user          User        @relation(fields: [userId], references: [id])
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  name          String
  departmentId  String
  department    Department  @relation(fields: [departmentId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  approvedPasses GatePass[] @relation("ApprovedBy")

  @@unique([id, institutionId])
  @@index([institutionId])
  @@map("hod_profiles")
}

// ΓöÇΓöÇΓöÇ GUARD PROFILE ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model GuardProfile {
  id            String      @id @default(cuid())
  userId        String      @unique
  user          User        @relation(fields: [userId], references: [id])
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  name          String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  assignedGates GuardGateAssignment[]
  gateEvents    GateEvent[]
  shifts        GuardShift[]

  @@unique([id, institutionId])
  @@index([institutionId])
  @@map("guard_profiles")
}

// ΓöÇΓöÇΓöÇ GATE ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model Gate {
  id            String      @id @default(cuid())
  name          String
  location      String?
  isActive      Boolean     @default(true)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  assignedGuards GuardGateAssignment[]
  gateEvents     GateEvent[]
  shifts         GuardShift[]

  @@unique([institutionId, name])
  @@unique([id, institutionId])
  @@map("gates")
}

// ΓöÇΓöÇΓöÇ GUARD Γåö GATE (many-to-many) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model GuardGateAssignment {
  id            String       @id @default(cuid())
  guardId       String
  guard         GuardProfile @relation(fields: [guardId], references: [id])
  gateId        String
  gate          Gate         @relation(fields: [gateId], references: [id])
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id])
  createdAt     DateTime     @default(now())

  @@unique([guardId, gateId])
  @@index([institutionId])
  @@map("guard_gate_assignments")
}

// ΓöÇΓöÇΓöÇ EXIT REASONS (configurable) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model ExitReason {
  id            String      @id @default(cuid())
  label         String
  requiresNote  Boolean     @default(false)
  isActive      Boolean     @default(true)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  gatePasses GatePass[]

  @@unique([id, institutionId])
  @@map("exit_reasons")
}

// ΓöÇΓöÇΓöÇ GATE PASS (core entity) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model GatePass {
  id             String         @id @default(cuid())
  passNumber     String         @unique
  institutionId  String
  institution    Institution    @relation(fields: [institutionId], references: [id])
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id])
  reasonId       String
  reason         ExitReason     @relation(fields: [reasonId], references: [id])
  customReason   String?
  requestedExit  DateTime
  expectedReturn DateTime
  status         PassStatus     @default(PENDING)

  // Approval
  approvedById    String?
  approvedBy      HodProfile? @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?

  // QR token
  qrToken     String?   @unique
  qrExpiresAt DateTime?

  // Actual times
  actualExit     DateTime?
  actualReturn   DateTime?
  overdueMinutes Int?

  // Allowance warning (set when pass created under warn_only with exhausted allowance)
  allowanceWarning String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gateEvents        GateEvent[]
  emergencyOverride EmergencyOverride?

  @@unique([id, institutionId])
  @@index([studentId, status])
  @@index([status, createdAt])
  @@index([institutionId])
  @@map("gate_passes")
}

// ΓöÇΓöÇΓöÇ GATE EVENTS ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model GateEvent {
  id            String        @id @default(cuid())
  passId        String
  pass          GatePass      @relation(fields: [passId], references: [id])
  gateId        String
  gate          Gate          @relation(fields: [gateId], references: [id])
  guardId       String
  guard         GuardProfile  @relation(fields: [guardId], references: [id])
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id])
  eventType     GateEventType
  timestamp     DateTime      @default(now())
  method        String        @default("QR_SCAN")

  @@index([passId, eventType])
  @@index([institutionId])
  @@map("gate_events")
}

// ΓöÇΓöÇΓöÇ GUARD SHIFTS ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model GuardShift {
  id               String           @id @default(cuid())
  institutionId    String
  institution      Institution      @relation(fields: [institutionId], references: [id])
  guardId          String
  guard            GuardProfile     @relation(fields: [guardId], references: [id])
  gateId           String
  gate             Gate             @relation(fields: [gateId], references: [id])
  status           GuardShiftStatus @default(SCHEDULED)
  scheduledStartAt DateTime
  scheduledEndAt   DateTime
  actualStartAt    DateTime?
  actualEndAt      DateTime?
  note             String?
  createdById      String?
  createdBy        User?            @relation("ShiftCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([institutionId, scheduledStartAt])
  @@index([guardId, status])
  @@index([gateId, status])
  @@map("guard_shifts")
}

// ΓöÇΓöÇΓöÇ AUDIT LOG ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model AuditLog {
  id            String      @id @default(cuid())
  actorId       String
  actor         User        @relation("AuditActor", fields: [actorId], references: [id])
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  action        AuditAction
  targetId      String?
  targetType    String?
  metadata      Json?
  timestamp     DateTime    @default(now())

  @@index([actorId, timestamp])
  @@index([action, timestamp])
  @@index([institutionId])
  @@map("audit_logs")
}

// ΓöÇΓöÇΓöÇ AUDIT EVENT v2 (Super Admin & platform security, FEAT-001) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// Generic string-keyed audit table (action validated against the shared
// catalogue, not a pg enum) with a NULLABLE institutionId for platform actions.
// Single-column FKs: the actor can be a platform user with no membership and
// rows may precede/cross tenant context, so no composite tenant FK here.
model AuditEvent {
  id                String        @id @default(cuid())
  institutionId     String?
  institution       Institution?  @relation(fields: [institutionId], references: [id])
  actorUserId       String
  actorUser         User          @relation("AuditEventActor", fields: [actorUserId], references: [id])
  actorMembershipId String?
  actorRoleKey      String
  action            String
  resourceType      String
  resourceId        String?
  result            AuditResult
  supportGrantId    String?
  supportGrant      SupportGrant? @relation(fields: [supportGrantId], references: [id])
  requestRef        String?
  metadata          Json?
  timestamp         DateTime      @default(now())

  @@index([institutionId, timestamp])
  @@index([actorUserId, timestamp])
  @@index([action, timestamp])
  @@index([supportGrantId])
  @@map("audit_events")
}

// ΓöÇΓöÇΓöÇ SUPPORT GRANT (break-glass, FEAT-001) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// PLATFORM-owned, single-tenant, purpose-bound, time-limited, revocable,
// tenant-visible, fully audited break-glass authorization record.
model SupportGrant {
  id              String             @id @default(cuid())
  institutionId   String
  institution     Institution        @relation(fields: [institutionId], references: [id])
  grantedToUserId String
  grantedToUser   User               @relation("SupportGrantGrantee", fields: [grantedToUserId], references: [id])
  purpose         String
  scope           Json?
  status          SupportGrantStatus @default(REQUESTED)
  requestedAt     DateTime           @default(now())
  activatedAt     DateTime?
  expiresAt       DateTime
  revokedAt       DateTime?
  revokedByUserId String?
  revokedByUser   User?              @relation("SupportGrantRevoker", fields: [revokedByUserId], references: [id])
  revokedReason   String?
  createdAt       DateTime           @default(now())

  auditEvents     AuditEvent[]

  @@index([institutionId, status])
  @@index([grantedToUserId, status])
  @@map("support_grants")
}

// ΓöÇΓöÇΓöÇ MODULE ENTITLEMENT / ACTIVATION (CAMPASS booster model, architecture.md ┬º5) ΓöÇ
// TENANT-OWNED lifecycle row for one (institution, module) pair. The four states
// in architecture.md ┬º5.2 are NOT_ENTITLED -> ENTITLED -> ACTIVE <-> SUSPENDED;
// NOT_ENTITLED is modelled as the ABSENCE of a row, so the enum holds only the
// three states a row can be in. Platform grants/revokes entitlement (privileged
// path); the tenant admin activates/suspends under RLS. who/when fields carry
// actor ids only (no composite FK ΓÇö a platform actor has no membership in this
// tenant, mirroring AuditEvent.actorUserId).
model InstitutionModule {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  moduleKey     String // validated against MODULE_KEYS in @campusgate/shared
  state         ModuleState @default(ENTITLED)

  entitledAt  DateTime  @default(now())
  activatedAt DateTime?
  suspendedAt DateTime?

  settings Json? // optional per-institution module config (future required-config hook)

  entitledByUserId  String?
  activatedByUserId String?
  suspendedByUserId String?
  updatedAt         DateTime @updatedAt

  @@unique([institutionId, moduleKey])
  @@unique([id, institutionId])
  @@index([institutionId])
  @@map("institution_modules")
}

// ΓöÇΓöÇΓöÇ ACADEMIC SESSION / TERM (Phase 1, tenant-owned) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model AcademicSession {
  id            String                @id @default(cuid())
  institutionId String
  institution   Institution           @relation(fields: [institutionId], references: [id])
  name          String
  structureType AcademicStructureType
  status        AcademicSessionStatus @default(UPCOMING)
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  terms                AcademicTerm[]
  calendarDays         AcademicCalendarDay[]
  calendarDayRevisions AcademicCalendarDayRevision[]
  enrolledStudents     StudentProfile[]
  classSections        ClassSection[]
  admissionCampaigns   AdmissionCampaign[]
  enrollments          Enrollment[]
  feeStructures        FeeStructure[]
  concessionDefinitions ConcessionDefinition[]
  examinations         Examination[]

  @@unique([institutionId, name])
  @@unique([id, institutionId])
  @@index([institutionId])
  @@index([institutionId, status])
  @@map("academic_sessions")
}

model AcademicTerm {
  id                String             @id @default(cuid())
  institutionId     String
  institution       Institution        @relation(fields: [institutionId], references: [id])
  academicSessionId String
  academicSession   AcademicSession    @relation(fields: [academicSessionId], references: [id])
  name              String
  ordinal           Int
  status            AcademicTermStatus @default(UPCOMING)
  startDate         DateTime
  endDate           DateTime
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  calendarDays         AcademicCalendarDay[]
  calendarDayRevisions AcademicCalendarDayRevision[]
  currentTermStudents  StudentProfile[]
  courses              Course[]
  classSections        ClassSection[]
  facultyAssignments   FacultyAssignment[]
  timetables           Timetable[]
  scheduledClasses     ScheduledClass[]
  attendanceSessions   AttendanceSession[]
  examinations         Examination[]
  facultyWorkloads       FacultyWorkload[]
  facultyTeachingHistory FacultyTeachingHistory[]

  @@unique([academicSessionId, ordinal])
  @@unique([id, institutionId])
  @@index([institutionId])
  @@index([academicSessionId])
  @@map("academic_terms")
}

// ΓöÇΓöÇΓöÇ PROGRAM (Phase 1, tenant-owned) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model Program {
  id            String              @id @default(cuid())
  institutionId String
  institution   Institution         @relation(fields: [institutionId], references: [id])
  departmentId  String
  department    Department          @relation(fields: [departmentId], references: [id])
  name          String
  code          String
  duration      Int
  durationUnit  ProgramDurationUnit @default(TERMS)
  status        ProgramStatus       @default(ACTIVE)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  students StudentProfile[]

  courses       Course[]
  classSections ClassSection[]

  admissionCampaigns        AdmissionCampaign[]        @relation("CampaignTargetProgram")
  admissionCampaignPrograms AdmissionCampaignProgram[]
  applications              Application[]
  admissionOffers           AdmissionOffer[]           @relation("OfferOfferedProgram")
  feeStructures             FeeStructure[]
  concessionDefinitions     ConcessionDefinition[]
  examinations              Examination[]

  @@unique([institutionId, code])
  @@unique([id, institutionId])
  @@index([institutionId])
  @@index([departmentId])
  @@map("programs")
}

// ΓöÇΓöÇΓöÇ ACADEMIC CALENDAR DAY REVISION (Phase 1, tenant-owned, append-only) ΓöÇΓöÇΓöÇΓöÇ

model AcademicCalendarDayRevision {
  id                String           @id @default(cuid())
  institutionId     String
  institution       Institution      @relation(fields: [institutionId], references: [id])
  calendarDayId     String?
  date              DateTime
  departmentId      String?
  previousDayType   AcademicDayType?
  newDayType        AcademicDayType?
  previousNote      String?
  newNote           String?
  changeType        String
  actorUserId       String
  academicSessionId String?
  academicSession   AcademicSession? @relation(fields: [academicSessionId], references: [id])
  academicTermId    String?
  academicTerm      AcademicTerm?    @relation(fields: [academicTermId], references: [id])
  createdAt         DateTime         @default(now())

  @@unique([id, institutionId])
  @@index([institutionId])
  @@index([institutionId, date])
  @@index([calendarDayId])
  @@map("academic_calendar_day_revisions")
}

// ΓöÇΓöÇΓöÇ NOTIFICATIONS ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model Notification {
  id            String      @id @default(cuid())
  userId        String
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  title         String
  body          String
  type          String
  data          Json?
  read          Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([userId, read, createdAt])
  @@index([institutionId])
  @@map("notifications")
}

// ΓöÇΓöÇΓöÇ ALLOWANCE POLICY ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model InstitutionConfig {
  id                           String       @id @default(cuid())
  institutionId                String       @unique
  institution                  Institution  @relation(fields: [institutionId], references: [id])
  timezone                     String       @default("Asia/Kolkata")
  weekStartDay                 WeekStartDay @default(MONDAY)
  workingDaysOfWeek            Json         @default("[1,2,3,4,5,6]")
  lowAllowanceThresholdMinutes Int          @default(60)
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt

  @@map("institution_configs")
}

model AcademicCalendarDay {
  id            String          @id @default(cuid())
  institutionId String
  institution   Institution     @relation(fields: [institutionId], references: [id])
  date          DateTime
  dayType       AcademicDayType
  note          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Phase 1 generalization (all nullable; existing rows stay valid).
  departmentId      String?
  department        Department?      @relation(fields: [departmentId], references: [id])
  academicSessionId String?
  academicSession   AcademicSession? @relation(fields: [academicSessionId], references: [id])
  academicTermId    String?
  academicTerm      AcademicTerm?    @relation(fields: [academicTermId], references: [id])

  @@index([institutionId, date])
  @@map("academic_calendar_days")
}

model AllowancePolicy {
  id                     String          @id @default(cuid())
  institutionId          String          @unique
  institution            Institution     @relation(fields: [institutionId], references: [id])
  allowanceAmount        Int             @default(1440) // minutes, [60, 10080]
  policyPeriod           PolicyPeriod    @default(WEEKLY)
  gracePeriod            Int             @default(10) // minutes, [0, 60]
  enforcement            EnforcementMode @default(WARN_ONLY)
  minimumSampleSize      Int             @default(5) // [3, 20]
  severityMinorMax       Int             @default(15)
  severityModerateMax    Int             @default(60)
  severitySignificantMax Int             @default(180)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@map("allowance_policies")
}

// ΓöÇΓöÇΓöÇ EMERGENCY OVERRIDE ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model EmergencyOverride {
  id             String      @id @default(cuid())
  gatePassId     String      @unique
  gatePass       GatePass    @relation(fields: [gatePassId], references: [id])
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id])
  overriddenById String
  overriddenBy   User        @relation("OverrideActor", fields: [overriddenById], references: [id])
  justification  String // min 10 characters
  createdAt      DateTime    @default(now())

  @@index([institutionId])
  @@map("emergency_overrides")
}

model EmergencyAlert {
  id             String          @id @default(cuid())
  institutionId  String
  institution    Institution     @relation(fields: [institutionId], references: [id])
  type           EmergencyType
  status         EmergencyStatus @default(ACTIVE)
  title          String
  message        String
  affectedArea   String?
  declaredById   String
  declaredBy     User            @relation("EmergencyDeclaredBy", fields: [declaredById], references: [id])
  declaredAt     DateTime        @default(now())
  resolvedById   String?
  resolvedBy     User?           @relation("EmergencyResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([institutionId, status, declaredAt])
  @@map("emergency_alerts")
}

// ΓöÇΓöÇΓöÇ RELIABILITY SCORE SNAPSHOT ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model ReliabilityScoreSnapshot {
  id             String         @id @default(cuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id])
  institutionId  String
  institution    Institution    @relation(fields: [institutionId], references: [id])
  score          Float // 0.0ΓÇô5.0
  movementNumber Int // sequential movement count at time of snapshot
  computedAt     DateTime       @default(now())

  @@index([studentId, computedAt])
  @@index([institutionId])
  @@map("reliability_score_snapshots")
}

// ΓöÇΓöÇΓöÇ SESSION & DEVICE SECURITY ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Stores the JWT jti claim ΓÇö revoke by marking this row revoked
  jti          String    @unique
  deviceName   String?
  deviceType   String?   // "desktop" | "mobile" | "tablet"
  browser      String?
  os           String?
  ipAddress    String?
  revoked      Boolean   @default(false)
  revokedAt    DateTime?
  revokedReason String?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime

  @@index([userId, revoked])
  @@index([jti])
  @@map("sessions")
}

model SecurityEvent {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  institutionId String?
  eventType     SecurityEventType
  ipAddress     String?
  deviceInfo    String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([institutionId, eventType, createdAt])
  @@map("security_events")
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  SESSION_REVOKED
  SESSION_EXPIRED
  PASSWORD_CHANGED
  SUSPICIOUS_ACTIVITY
  ACCOUNT_LOCKED
  NEW_DEVICE_LOGIN
}

// ΓöÇΓöÇΓöÇ CLASS & COURSE MANAGEMENT (Phase 3 ΓÇö classes.*) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// Tenant-owned class/course/timetable domain. RLS, composite same-tenant FKs,
// CHECK constraints, and the schedule_revisions append-only trigger are carried
// by the hand-authored 20261028000000_phase3_classes migration (Prisma does not
// model them). Course.status / Subject.status deliberately reuse ProgramStatus
// (design ┬º6.2): a course/subject shares the ACTIVE/INACTIVE lifecycle of a
// program, independent of its program's own status.

enum ClassSectionStatus {
  PLANNED
  ACTIVE
  CLOSED
  CANCELLED
}

enum EnrollmentStatus {
  ENROLLED
  DROPPED
  COMPLETED
}

enum FacultyStatus {
  ACTIVE
  INACTIVE
}

enum FacultyAssignmentRole {
  PRIMARY
  SUBSTITUTE
  ASSISTANT
}

enum FacultyAssignmentStatus {
  ACTIVE
  ENDED
}

enum TimetableStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ScheduledClassStatus {
  SCHEDULED
  CANCELLED
}

enum DayOfWeek {
  SUN
  MON
  TUE
  WED
  THU
  FRI
  SAT
}

enum ScheduleRevisionChangeType {
  TIMETABLE_CREATED
  TIMETABLE_PUBLISHED
  TIMETABLE_ARCHIVED
  SCHEDULED_CLASS_ADDED
  SCHEDULED_CLASS_UPDATED
  SCHEDULED_CLASS_CANCELLED
  FACULTY_REASSIGNED
}

model Course {
  id             String        @id @default(cuid())
  institutionId  String
  institution    Institution   @relation(fields: [institutionId], references: [id])
  programId      String
  program        Program       @relation(fields: [programId], references: [id])
  academicTermId String?
  academicTerm   AcademicTerm? @relation(fields: [academicTermId], references: [id])
  name           String
  code           String
  description    String?
  status         ProgramStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  subjects Subject[]

  @@unique([institutionId, code])
  @@unique([id, institutionId])
  @@index([institutionId])
  @@index([programId])
  @@map("courses")
}

model Subject {
  id                  String        @id @default(cuid())
  institutionId       String
  institution         Institution   @relation(fields: [institutionId], references: [id])
  courseId            String
  course              Course        @relation(fields: [courseId], references: [id])
  name                String
  code                String
  credits             Int?
  contactHoursPerWeek Int?
  status              ProgramStatus @default(ACTIVE)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  facultyAssignments FacultyAssignment[]
  scheduledClasses   ScheduledClass[]
  examSchedules      ExamSchedule[]
  assessments        Assessment[]
  resultSnapshots    ResultSnapshot[]
  reevalRequests     ReevalRequest[]
  facultyTeachingHistory FacultyTeachingHistory[]

  @@unique([institutionId, code])
  @@unique([id, institutionId])
  @@index([institutionId])
  @@index([courseId])
  @@map("subjects")
}

model ClassSection {
  id                String             @id @default(cuid())
  institutionId     String
  institution       Institution        @relation(fields: [institutionId], references: [id])
  programId         String
  program           Program            @relation(fields: [programId], references: [id])
  academicSessionId String
  academicSession   AcademicSession    @relation(fields: [academicSessionId], references: [id])
  academicTermId    String
  academicTerm      AcademicTerm       @relation(fields: [academicTermId], references: [id])
  label             String?
  capacity          Int?
  status            ClassSectionStatus @default(PLANNED)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  enrollments      ClassEnrollment[]
  scheduledClasses ScheduledClass[]
  assignments      FacultyAssignment[]
  facultyTeachingHistory FacultyTeachingHistory[]

  @@unique([institutionId, programId, academicSessionId, academicTermId, label])
  @@unique([id, institutionId])
  @@index([institutionId])
  @@index([institutionId, academicTermId])
  @@map("class_sections")
}

model ClassEnrollment {
  id             String           @id @default(cuid())
  institutionId  String
  institution    Institution      @relation(fields: [institutionId], references: [id])
  classSectionId String
  classSection   ClassSection     @relation(fields: [classSectionId], references: [id])
  studentId      String
  student        StudentProfile   @relation(fields: [studentId], references: [id])
  enrolledAt     DateTime         @default(now())
  status         EnrollmentStatus @default(ENROLLED)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([classSectionId, studentId])
  @@unique([id, institutionId])
  @@index([institutionId])
  @@index([institutionId, studentId])
  @@index([classSectionId])
  @@map("class_enrollments")
}

model FacultyProfile {
  id            String        @id @default(cuid())
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id])
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id])
  name          String
  departmentId  String?
  department    Department?   @relation(fields: [departmentId], references: [id])
  status        FacultyStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  assignments        FacultyAssignment[]
  scheduledClasses   ScheduledClass[]
  attendanceSessions AttendanceSession[]
  qualifications     FacultyQualification[]
  workloads          FacultyWorkload[]
  teachingHistory    FacultyTeachingHistory[]

  @@unique([id, institutionId])
  @@index([institutionId])
  @@map("faculty_profiles")
}

model FacultyAssignment {
  id             String                  @id @default(cuid())
  institutionId  String
  institution    Institution             @relation(fields: [institutionId], references: [id])
  facultyId      String
  faculty        FacultyProfile          @relation(fields: [facultyId], references: [id])
  subjectId      String
  subject        Subject                 @relation(fields: [subjectId], references: [id])
  classSectionId String?
  classSection   ClassSection?           @relation(fields: [classSectionId], references: [id])
  academicTermId String
  academicTerm   AcademicTerm            @relation(fields: [academicTermId], references: [id])
  role           FacultyAssignmentRole   @default(PRIMARY)
  status         FacultyAssignmentStatus @default(ACTIVE)
  assignedAt     DateTime                @default(now())
  endedAt        DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([id, institutionId])
  @@index([institutionId])
  @@index([institutionId, facultyId, status])
  @@index([subjectId])
  @@map("faculty_assignments")
}

model Timetable {
  id             String          @id @default(cuid())
  institutionId  String
  institution    Institution     @relation(fields: [institutionId], references: [id])
  academicTermId String
  academicTerm   AcademicTerm    @relation(fields: [academicTermId], references: [id])
  name           String
  status         TimetableStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  scheduledClasses ScheduledClass[]

  @@unique([id, institutionId])
  @@index([institutionId])
  @@index([institutionId, academicTermId])
  @@map("timetables")
}

model ScheduledClass {
  id             String               @id @default(cuid())
  institutionId  String
  institution    Institution          @relation(fields: [institutionId], references: [id])
  timetableId    String
  timetable      Timetable            @relation(fields: [timetableId], references: [id])
  classSectionId String
  classSection   ClassSection         @relation(fields: [classSectionId], references: [id])
  subjectId      String
  subject        Subject              @relation(fields: [subjectId], references: [id])
  facultyId      String
  faculty        FacultyProfile       @relation(fields: [facultyId], references: [id])
  academicTermId String
  academicTerm   AcademicTerm         @relation(fields: [academicTermId], references: [id])
  room           String?
  dayOfWeek      DayOfWeek?
  date           DateTime?
  startTime      Int
  endTime        Int
  period         Int?
  status         ScheduledClassStatus @default(SCHEDULED)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  attendanceSessions AttendanceSession[]

  @@unique([id, institutionId])
  @@unique([institutionId, id, academicTermId]) // FK target for AttendanceSession term integrity (Phase 4)
  @@index([institutionId])
  @@index([institutionId, academicTermId, dayOfWeek])
  @@index([facultyId])
  @@index([classSectionId])
  @@map("scheduled_classes")
}

model ScheduleRevision {
  id               String                     @id @default(cuid())
  institutionId    String
  institution      Institution                @relation(fields: [institutionId], references: [id])
  timetableId      String?
  scheduledClassId String?
  academicTermId   String?
  changeType       ScheduleRevisionChangeType

  previousFacultyId String?
  newFacultyId      String?
  previousRoom      String?
  newRoom           String?
  previousStartTime Int?
  newStartTime      Int?
  previousEndTime   Int?
  newEndTime        Int?
  previousStatus    String?
  newStatus         String?

  actorUserId       String
  actorMembershipId String?
  reason            String?
  metadata          Json?
  createdAt         DateTime @default(now())

  @@unique([id, institutionId])
  @@index([institutionId])
  @@index([institutionId, timetableId])
  @@index([scheduledClassId])
  @@map("schedule_revisions")
}

// ΓöÇΓöÇΓöÇ ATTENDANCE (Phase 4, tenant-owned) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// Four new tables recording attendance against the Phase 3 scheduling substrate
// plus a controlled correction workflow. All follow the A2 tenancy checklist
// (institutionId + composite same-tenant FKs + ENABLE/FORCE RLS). The composite
// FKs, RLS policies, CHECK constraints, append-only trigger, GRANT refresh and
// catalogue seed live in the hand-authored migration 20261101000000_phase4_attendance.

enum AttendanceSessionStatus {
  OPEN // created; records being marked
  SUBMITTED // faculty submitted; still correctable in place by the marker before finalize
  FINALIZED // locked; records immutable except via an approved AttendanceCorrection
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED // documented synonym for "approved leave"
}

enum AttendanceCorrectionReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceRecordHistoryChangeType {
  MARKED // initial mark inside an OPEN/SUBMITTED session
  CORRECTED // value changed by an APPROVED correction on a FINALIZED record
}

model AttendanceSession {
  id                 String                  @id @default(cuid())
  institutionId      String
  institution        Institution             @relation(fields: [institutionId], references: [id])
  scheduledClassId   String
  scheduledClass     ScheduledClass          @relation(fields: [scheduledClassId], references: [id])
  academicTermId     String
  academicTerm       AcademicTerm            @relation(fields: [academicTermId], references: [id])
  date               DateTime // the calendar date (UTC midnight) the session covers
  status             AttendanceSessionStatus @default(OPEN)
  markedByFacultyId  String
  markedByFaculty    FacultyProfile          @relation(fields: [markedByFacultyId], references: [id])
  submissionDeadline DateTime? // optional; informational only in Phase 4
  submittedAt        DateTime?
  finalizedAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  records AttendanceRecord[]

  @@unique([scheduledClassId, date]) // one session per class occurrence per date
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, academicTermId, date])
  @@index([markedByFacultyId])
  @@index([scheduledClassId])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id                  String            @id @default(cuid())
  institutionId       String
  institution         Institution       @relation(fields: [institutionId], references: [id])
  attendanceSessionId String
  attendanceSession   AttendanceSession @relation(fields: [attendanceSessionId], references: [id])
  studentId           String
  student             StudentProfile    @relation(fields: [studentId], references: [id])
  status              AttendanceStatus
  markedAt            DateTime          @default(now())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  history     AttendanceRecordHistory[]
  corrections AttendanceCorrection[]

  @@unique([attendanceSessionId, studentId]) // one record per student per session
  @@unique([id, institutionId])
  @@index([institutionId])
  @@index([institutionId, studentId])
  @@index([attendanceSessionId])
  @@map("attendance_records")
}

model AttendanceCorrection {
  id                 String                           @id @default(cuid())
  institutionId      String
  institution        Institution                      @relation(fields: [institutionId], references: [id])
  attendanceRecordId String
  attendanceRecord   AttendanceRecord                 @relation(fields: [attendanceRecordId], references: [id])
  requestedByUserId  String // actor id (no composite FK)
  reason             String // REQUIRED, min length enforced in Zod + CHECK
  requestedStatus    AttendanceStatus // the status the requester wants applied
  priorStatus        AttendanceStatus // snapshot of the record's status at request time
  reviewStatus       AttendanceCorrectionReviewStatus @default(PENDING)
  reviewedByUserId   String?
  reviewedAt         DateTime?
  reviewNote         String?
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt

  @@unique([id, institutionId])
  @@index([institutionId])
  @@index([institutionId, reviewStatus])
  @@index([attendanceRecordId])
  @@map("attendance_corrections")
}

model AttendanceRecordHistory {
  id                 String                            @id @default(cuid())
  institutionId      String
  institution        Institution                       @relation(fields: [institutionId], references: [id])
  attendanceRecordId String
  attendanceRecord   AttendanceRecord                  @relation(fields: [attendanceRecordId], references: [id])
  changeType         AttendanceRecordHistoryChangeType
  previousStatus     AttendanceStatus? // null for the initial MARKED row
  newStatus          AttendanceStatus
  correctionId       String? // the AttendanceCorrection that drove a CORRECTED row (recorded id, no FK)
  actorUserId        String
  actorMembershipId  String?
  reason             String?
  metadata           Json?
  createdAt          DateTime                          @default(now())

  @@unique([id, institutionId])
  @@index([institutionId])
  @@index([institutionId, attendanceRecordId])
  @@index([attendanceRecordId])
  @@map("attendance_record_history")
}

// ΓöÇΓöÇΓöÇ LIBRARY (Phase 5, tenant-owned, gated module) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
//
// Five tenant-owned tables (BookTitle, BookCopy, LibraryLoan, BookReservation,
// LibraryFine) + seven enums. Each table carries institutionId +
// `institution Institution @relation(...)`, @@unique([id, institutionId]) (anchors
// composite same-tenant FKs), an (institutionId) index, and the design ┬º3 query
// indexes. The composite same-tenant FKs (incl. institutionId), partial unique
// indexes, RLS policies, CHECK constraints, GRANT refresh and the library.*
// permission/role seed live in the hand-authored migration
// 20261108000000_phase5_library (Prisma's diff models none of those). Prisma
// relations below reference the single PK; the tenant-safe composite variants are
// created as raw SQL in the migration.

enum BookTitleStatus {
  ACTIVE
  WITHDRAWN // retained for history; copies are withdrawn individually
}

enum BookCopyCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum BookCopyStatus {
  AVAILABLE
  ISSUED
  RESERVED // transient hold while a reservation is being fulfilled
  LOST
  DAMAGED
  WITHDRAWN
}

enum LibraryLoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
}

enum BookReservationStatus {
  PENDING
  FULFILLED
  CANCELLED
  EXPIRED
}

enum LibraryFineReason {
  OVERDUE
  LOST
  DAMAGED
}

enum LibraryFineStatus {
  PENDING
  PAID
  WAIVED
}

model BookTitle {
  id              String          @id @default(cuid())
  institutionId   String
  institution     Institution     @relation(fields: [institutionId], references: [id])
  title           String
  author          String
  publisher       String?
  isbn            String? // normalized (digits only) at the service layer; NOT business-unique (design ┬º3.1)
  category        String?
  edition         String?
  publicationYear Int?
  status          BookTitleStatus @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  copies       BookCopy[]
  reservations BookReservation[]

  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, isbn])
  @@index([institutionId, title])
  @@map("book_titles")
}

model BookCopy {
  id              String            @id @default(cuid())
  institutionId   String
  institution     Institution       @relation(fields: [institutionId], references: [id])
  bookTitleId     String
  bookTitle       BookTitle         @relation(fields: [bookTitleId], references: [id])
  accessionNumber String
  shelfLocation   String?
  condition       BookCopyCondition @default(GOOD)
  status          BookCopyStatus    @default(AVAILABLE)
  acquiredAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  loans                LibraryLoan[]
  fulfilledReservations BookReservation[] @relation("ReservationFulfilledByCopy")

  @@unique([institutionId, accessionNumber]) // accession number unique per institution
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, bookTitleId])
  @@index([institutionId, status])
  @@map("book_copies")
}

model LibraryLoan {
  id             String            @id @default(cuid())
  institutionId  String
  institution    Institution       @relation(fields: [institutionId], references: [id])
  bookCopyId     String
  bookCopy       BookCopy          @relation(fields: [bookCopyId], references: [id])
  studentId      String
  student        StudentProfile    @relation(fields: [studentId], references: [id])
  issuedByUserId String // acting librarian's User id (recorded scalar, NO FK)
  issueDate      DateTime          @default(now())
  dueDate        DateTime
  returnDate     DateTime?
  renewalCount   Int               @default(0)
  status         LibraryLoanStatus @default(ACTIVE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  fines LibraryFine[]

  // Partial unique index `library_loans_one_active_per_copy` on
  // (institutionId, bookCopyId) WHERE status='ACTIVE' is the hard concurrency
  // backstop (design ┬º5.2) ΓÇö Prisma cannot express a partial index, so it is
  // created as raw SQL in the migration.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, studentId, status])
  @@index([institutionId, status, dueDate])
  @@index([institutionId, bookCopyId])
  @@map("library_loans")
}

model BookReservation {
  id                String                @id @default(cuid())
  institutionId     String
  institution       Institution           @relation(fields: [institutionId], references: [id])
  bookTitleId       String
  bookTitle         BookTitle             @relation(fields: [bookTitleId], references: [id])
  studentId         String
  student           StudentProfile        @relation(fields: [studentId], references: [id])
  reservedAt        DateTime              @default(now())
  queuePosition     Int
  status            BookReservationStatus @default(PENDING)
  fulfilledByCopyId String?
  fulfilledByCopy   BookCopy?             @relation("ReservationFulfilledByCopy", fields: [fulfilledByCopyId], references: [id])
  fulfilledAt       DateTime?
  cancelledAt       DateTime?
  expiredAt         DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  // Partial unique index `book_reservations_one_pending_per_student_title` on
  // (institutionId, bookTitleId, studentId) WHERE status='PENDING' (design ┬º3.4)
  // ΓÇö created as raw SQL in the migration (Prisma cannot express it).
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, bookTitleId, status, queuePosition])
  @@index([institutionId, studentId, status])
  @@map("book_reservations")
}

model LibraryFine {
  id                   String            @id @default(cuid())
  institutionId        String
  institution          Institution       @relation(fields: [institutionId], references: [id])
  studentId            String
  student              StudentProfile    @relation(fields: [studentId], references: [id])
  libraryLoanId        String?
  libraryLoan          LibraryLoan?      @relation(fields: [libraryLoanId], references: [id])
  amount               Decimal           @db.Decimal(10, 2)
  reason               LibraryFineReason
  status               LibraryFineStatus @default(PENDING)
  note                 String?
  waivedByUserId       String? // recorded actor id (no FK)
  paidRecordedByUserId String? // recorded actor id (no FK)
  waivedAt             DateTime?
  paidAt               DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, studentId, status])
  @@index([institutionId, status])
  @@map("library_fines")
}

// ΓöÇΓöÇΓöÇ ADMISSIONS (Phase 6, tenant-owned) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

enum AdmissionCampaignStatus {
  DRAFT
  OPEN
  CLOSED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  DOCUMENTS_REQUIRED
  ELIGIBLE
  SHORTLISTED
  OFFERED
  ACCEPTED
  ENROLLED
  REJECTED
  WITHDRAWN
}

enum ApplicationReviewDecision {
  RECOMMEND_ELIGIBLE
  RECOMMEND_REJECT
  REQUEST_DOCUMENTS
  SHORTLIST
  NOTE
}

enum AdmissionOfferStatus {
  ISSUED
  ACCEPTED
  DECLINED
  EXPIRED
}

model AdmissionCampaign {
  id              String                  @id @default(cuid())
  institutionId   String
  institution     Institution             @relation(fields: [institutionId], references: [id])
  name            String
  status          AdmissionCampaignStatus @default(DRAFT)
  intakeSessionId String?
  intakeSession   AcademicSession?        @relation(fields: [intakeSessionId], references: [id])
  targetProgramId String?
  targetProgram   Program?                @relation("CampaignTargetProgram", fields: [targetProgramId], references: [id])
  openAt          DateTime?
  closeAt         DateTime?
  config          Json                    @default("{}")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  programs     AdmissionCampaignProgram[]
  applications Application[]

  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@unique([institutionId, name])
  @@index([institutionId])
  @@index([institutionId, status])
  @@map("admission_campaigns")
}

model AdmissionCampaignProgram {
  id            String            @id @default(cuid())
  institutionId String
  institution   Institution       @relation(fields: [institutionId], references: [id])
  campaignId    String
  campaign      AdmissionCampaign @relation(fields: [campaignId], references: [id])
  programId     String
  program       Program           @relation(fields: [programId], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@unique([institutionId, campaignId, programId])
  @@index([institutionId])
  @@index([institutionId, campaignId])
  @@map("admission_campaign_programs")
}

model Application {
  id                 String            @id @default(cuid())
  institutionId      String
  institution        Institution       @relation(fields: [institutionId], references: [id])
  campaignId         String
  campaign           AdmissionCampaign @relation(fields: [campaignId], references: [id])
  applicantUserId    String
  applicantUser      User              @relation("ApplicationApplicant", fields: [applicantUserId], references: [id])
  programId          String
  program            Program           @relation(fields: [programId], references: [id])
  status             ApplicationStatus @default(DRAFT)
  applicationNumber  String
  submittedAt        DateTime?
  withdrawnAt        DateTime?
  rejectedAt         DateTime?
  formData           Json              @default("{}")
  interviewAt        DateTime?
  applicationFeeRef  String?
  applicationFeePaid Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  documents   ApplicationDocument[]
  reviews     ApplicationReview[]
  offers      AdmissionOffer[]
  enrollments Enrollment[]

  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@unique([institutionId, applicationNumber])
  @@unique([institutionId, campaignId, applicantUserId]) // one application per campaign per applicant
  @@index([institutionId])
  @@index([institutionId, status])
  @@index([institutionId, campaignId, status])
  @@index([institutionId, applicantUserId])
  @@map("applications")
}

model ApplicationDocument {
  id               String      @id @default(cuid())
  institutionId    String
  institution      Institution @relation(fields: [institutionId], references: [id])
  applicationId    String
  application      Application @relation(fields: [applicationId], references: [id])
  docType          String
  reference        String
  fileName         String?
  contentType      String?
  verified         Boolean     @default(false)
  verifiedByUserId String? // recorded actor id (no FK)
  verifiedAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, applicationId])
  @@map("application_documents")
}

model ApplicationReview {
  id             String                    @id @default(cuid())
  institutionId  String
  institution    Institution               @relation(fields: [institutionId], references: [id])
  applicationId  String
  application    Application               @relation(fields: [applicationId], references: [id])
  reviewerUserId String // recorded actor id (no FK)
  decision       ApplicationReviewDecision
  notes          String?
  reviewedAt     DateTime                  @default(now())
  createdAt      DateTime                  @default(now())

  // Append-only (NO updatedAt): INSERT-only RLS + REVOKE UPDATE,DELETE + a
  // BEFORE UPDATE OR DELETE trigger are hand-authored in the migration
  // (mirrors attendance_record_history / student_profile_history).
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, applicationId])
  @@map("application_reviews")
}

model AdmissionOffer {
  id               String               @id @default(cuid())
  institutionId    String
  institution      Institution          @relation(fields: [institutionId], references: [id])
  applicationId    String
  application      Application          @relation(fields: [applicationId], references: [id])
  offeredProgramId String
  offeredProgram   Program              @relation("OfferOfferedProgram", fields: [offeredProgramId], references: [id])
  status           AdmissionOfferStatus @default(ISSUED)
  offeredAt        DateTime             @default(now())
  expiresAt        DateTime?
  acceptedAt       DateTime?
  declinedAt       DateTime?
  expiredAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  // Partial unique index `admission_offers_one_live_per_application` on
  // (institutionId, applicationId) WHERE status IN ('ISSUED','ACCEPTED') ΓÇö at
  // most one live offer per application (design ┬º5) ΓÇö Prisma cannot express a
  // partial index, so it is created as raw SQL in the migration.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, applicationId])
  @@index([institutionId, status])
  @@map("admission_offers")
}

model Enrollment {
  id                String          @id @default(cuid())
  institutionId     String
  institution       Institution     @relation(fields: [institutionId], references: [id])
  applicationId     String
  application       Application     @relation(fields: [applicationId], references: [id])
  studentProfileId  String
  studentProfile    StudentProfile  @relation(fields: [studentProfileId], references: [id])
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  enrolledAt        DateTime        @default(now())
  enrolledByUserId  String // recorded actor id (no FK)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@unique([institutionId, applicationId]) // one enrollment per application (idempotency backstop)
  @@index([institutionId])
  @@index([institutionId, studentProfileId])
  @@index([institutionId, applicationId])
  @@map("enrollments")
}

// ΓöÇΓöÇΓöÇ FEES & PAYMENTS (Phase 7 slice 1, tenant-owned) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
//
// Money is INTEGER PAISE (BigInt) end-to-end; currency is a stored non-null
// 'INR' (CHECK currency = 'INR' in the migration). Prisma models reference
// SINGLE PKs; the composite same-tenant FKs (incl. institutionId), partial
// unique (payment_transactions_payment_id_unique), the global unique on
// processed_webhook_events.razorpayEventId, ENABLE+FORCE RLS, the two
// append-only trigger families (unconditional-raise x3 + column-guard x2), the
// campass_app GRANT refresh, and the fees.* + ACCOUNTANT catalogue seed are all
// hand-authored raw SQL in the 20261122000000_phase7_fees_slice1 migration
// (Prisma's diff models none of them).

enum FeeStructureStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum FeeComponentCategory {
  TUITION
  LIBRARY
  LAB
  EXAM
  OTHER
}

enum StudentChargeStatus {
  PENDING
  PARTIALLY_PAID
  PAID
}

enum PaymentTransactionStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
}

model FeeStructure {
  id                String             @id @default(cuid())
  institutionId     String
  institution       Institution        @relation(fields: [institutionId], references: [id])
  name              String
  status            FeeStructureStatus @default(DRAFT)
  programId         String?
  program           Program?           @relation(fields: [programId], references: [id])
  academicSessionId String?
  academicSession   AcademicSession?   @relation(fields: [academicSessionId], references: [id])
  description       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  components     FeeComponent[]
  studentCharges StudentCharge[]

  // Composite same-tenant FKs (institutionId, programId)->programs and
  // (institutionId, academicSessionId)->academic_sessions, plus CHECK
  // char_length(name) >= 1, are raw SQL in the migration.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@unique([institutionId, name])
  @@index([institutionId])
  @@map("fee_structures")
}

model FeeComponent {
  id                String               @id @default(cuid())
  institutionId     String
  institution       Institution          @relation(fields: [institutionId], references: [id])
  feeStructureId    String
  feeStructure      FeeStructure         @relation(fields: [feeStructureId], references: [id])
  category          FeeComponentCategory
  amountPaise       BigInt
  currency          String               @default("INR")
  dueDate           DateTime?
  installmentLabel  String?
  installmentNumber Int?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  studentCharges StudentCharge[]

  // Composite same-tenant FK (institutionId, feeStructureId)->fee_structures,
  // plus CHECK amountPaise > 0 and CHECK currency = 'INR', are raw SQL in the
  // migration.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, feeStructureId])
  @@map("fee_components")
}

model StudentCharge {
  id             String              @id @default(cuid())
  institutionId  String
  institution    Institution         @relation(fields: [institutionId], references: [id])
  studentId      String
  student        StudentProfile      @relation(fields: [studentId], references: [id])
  feeStructureId String?
  feeStructure   FeeStructure?       @relation(fields: [feeStructureId], references: [id])
  feeComponentId String?
  feeComponent   FeeComponent?       @relation(fields: [feeComponentId], references: [id])
  category       FeeComponentCategory
  amountPaise    BigInt
  currency       String              @default("INR")
  dueDate        DateTime?
  description    String
  status         StudentChargeStatus @default(PENDING)
  postedAt       DateTime            @default(now())
  postedByUserId String // recorded actor id (no FK)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  allocations       PaymentAllocation[]
  concessionCredits ConcessionCredit[]
  refundReversals   RefundReversal[]
  adjustments       Adjustment[]

  // Posted = IMMUTABLE SNAPSHOT: only `status` (forward-only ΓÇö relaxed in slice
  // 7.1 to any valid state, see migration ┬ºE.1) and `updatedAt`
  // may change. The column-guard trigger `student_charges_guard` (raw SQL,
  // migration ┬ºh, copied verbatim from design ┬ºD.3) freezes every snapshot
  // column and enforces the forward-only status transition. Composite
  // same-tenant FKs (studentId->student_profiles, feeStructureId->fee_structures,
  // feeComponentId->fee_components) + CHECKs (amountPaise > 0, currency = 'INR',
  // char_length(description) >= 1) are raw SQL in the migration.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, studentId])
  @@index([institutionId, studentId, status])
  @@index([institutionId, status])
  @@map("student_charges")
}

model PaymentTransaction {
  id                String                   @id @default(cuid())
  institutionId     String
  institution       Institution              @relation(fields: [institutionId], references: [id])
  studentId         String
  student           StudentProfile           @relation(fields: [studentId], references: [id])
  amountPaise       BigInt
  currency          String                   @default("INR")
  status            PaymentTransactionStatus @default(CREATED)
  razorpayOrderId   String
  razorpayPaymentId String?
  razorpaySignature String?
  targetChargeIds   String[] // authoritative server-persisted charge-id set (NOT a FK; ┬ºD.2 NIT-1)
  initiatedByUserId String? // recorded actor id (no FK)
  createdAt         DateTime                 @default(now())
  capturedAt        DateTime?
  updatedAt         DateTime                 @updatedAt

  allocations          PaymentAllocation[]
  receipts             Receipt[]
  processedWebhookEvents ProcessedWebhookEvent[]
  refunds              Refund[]

  // APPEND-ONLY fact: identity/amount columns immutable, status forward-only,
  // terminal (CAPTURED/FAILED) frozen ΓÇö enforced by the column-guard trigger
  // `payment_transactions_guard` (raw SQL, migration ┬ºh, copied verbatim from
  // design ┬ºD.3). Unique (institutionId, razorpayOrderId) + the partial unique
  // `payment_transactions_payment_id_unique` on (institutionId, razorpayPaymentId)
  // WHERE razorpayPaymentId IS NOT NULL (raw SQL), the composite same-tenant FK
  // (studentId->student_profiles), and CHECKs (amountPaise > 0, currency = 'INR')
  // are in the migration.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@unique([institutionId, razorpayOrderId])
  @@index([institutionId])
  @@index([institutionId, status])
  @@index([institutionId, status, createdAt])
  @@index([institutionId, studentId])
  @@map("payment_transactions")
}

model PaymentAllocation {
  id                   String             @id @default(cuid())
  institutionId        String
  institution          Institution        @relation(fields: [institutionId], references: [id])
  paymentTransactionId String
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id])
  studentChargeId      String
  studentCharge        StudentCharge      @relation(fields: [studentChargeId], references: [id])
  amountPaise          BigInt
  currency             String             @default("INR")
  createdAt            DateTime           @default(now())

  // INSERT-only (NO updatedAt): append-only RLS (SELECT + INSERT) + REVOKE
  // UPDATE,DELETE + a BEFORE UPDATE OR DELETE trigger are hand-authored in the
  // migration (mirrors application_reviews). Composite same-tenant FKs
  // (paymentTransactionId->payment_transactions, studentChargeId->student_charges)
  // + CHECKs (amountPaise > 0, currency = 'INR') are raw SQL in the migration.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, paymentTransactionId])
  @@index([institutionId, studentChargeId])
  @@map("payment_allocations")
}

model Receipt {
  id                   String             @id @default(cuid())
  institutionId        String
  institution          Institution        @relation(fields: [institutionId], references: [id])
  paymentTransactionId String
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id])
  receiptNumber        String
  sequence             Int
  amountPaise          BigInt
  currency             String             @default("INR")
  issuedAt             DateTime           @default(now())
  createdAt            DateTime           @default(now())

  // INSERT-only (NO updatedAt): append-only RLS + REVOKE UPDATE,DELETE + trigger
  // are hand-authored in the migration. Composite same-tenant FK
  // (paymentTransactionId->payment_transactions) + CHECKs (amountPaise > 0,
  // currency = 'INR', sequence > 0) are raw SQL in the migration.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@unique([institutionId, receiptNumber])
  @@unique([institutionId, sequence]) // monotonic per-institution counter (NIT-3)
  @@unique([institutionId, paymentTransactionId]) // one receipt per transaction
  @@index([institutionId])
  @@map("receipts")
}

model ProcessedWebhookEvent {
  id                   String              @id @default(cuid())
  institutionId        String
  institution          Institution         @relation(fields: [institutionId], references: [id])
  razorpayEventId      String
  eventType            String
  processedAt          DateTime            @default(now())
  paymentTransactionId String?
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id])
  payloadDigest        String?
  createdAt            DateTime            @default(now())

  // INSERT-only idempotency ledger (NO updatedAt): append-only RLS + REVOKE
  // UPDATE,DELETE + trigger are hand-authored in the migration. The GLOBAL
  // unique on razorpayEventId (the hard idempotency key, ┬ºD.7) + the composite
  // (institutionId, razorpayEventId) unique + the composite same-tenant FK
  // (paymentTransactionId->payment_transactions, nullable) are raw SQL in the
  // migration.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@unique([razorpayEventId]) // GLOBAL idempotency key (┬ºD.7)
  @@unique([institutionId, razorpayEventId])
  @@index([institutionId])
  @@index([institutionId, paymentTransactionId])
  @@map("processed_webhook_events")
}

// ΓöÇΓöÇΓöÇ FEES & PAYMENTS (Phase 7 slice 7.1): concessions, refunds, adjustments ΓöÇΓöÇ
// Money-OUT + corrections half of the ledger. Strictly additive; never mutates
// a captured fact. Six new tables: concession_definitions + refunds are mutable
// (standard RLS pair; refunds carries a column-guard like payment_transactions);
// student_concessions, concession_credits, refund_reversals, adjustments are
// INSERT-only append-only ledger rows. All composite same-tenant FKs, CHECKs,
// RLS, triggers, and the partial unique on refunds.razorpayRefundId are raw SQL
// in the 20261129000000_phase7_fees_slice2 migration.

enum ConcessionType {
  FIXED
  PERCENT
}

enum ConcessionScope {
  PER_STUDENT
  PER_STRUCTURE
}

enum RefundStatus {
  REQUESTED
  PROCESSED
  FAILED
}

enum AdjustmentType {
  WAIVER
  WRITE_OFF
  CORRECTION
}

// Carried for documentation parity with the pg enum; not referenced by a column
// (the ledger kind is implied by the table). Kept so the pg type exists.
enum LedgerEntryKind {
  CONCESSION
  ADJUSTMENT
  REFUND_REVERSAL
}

model ConcessionDefinition {
  id                String             @id @default(cuid())
  institutionId     String
  institution       Institution        @relation(fields: [institutionId], references: [id])
  name              String
  type              ConcessionType
  amountPaise       BigInt? // required when type=FIXED (CHECK in migration)
  percentBps        Int? // required when type=PERCENT; 1..10000 (CHECK in migration)
  scope             ConcessionScope
  programId         String?
  program           Program?           @relation(fields: [programId], references: [id])
  academicSessionId String?
  academicSession   AcademicSession?   @relation(fields: [academicSessionId], references: [id])
  note              String?
  status            FeeStructureStatus @default(DRAFT)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  studentConcessions StudentConcession[]

  // Composite same-tenant FKs (institutionId, programId)->programs and
  // (institutionId, academicSessionId)->academic_sessions, the FIXED/PERCENT
  // exclusivity CHECK, char_length(name) >= 1, percentBps BETWEEN 1 AND 10000,
  // and RLS are raw SQL in the migration.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@unique([institutionId, name])
  @@index([institutionId])
  @@map("concession_definitions")
}

model StudentConcession {
  id                     String               @id @default(cuid())
  institutionId          String
  institution            Institution          @relation(fields: [institutionId], references: [id])
  concessionDefinitionId String
  concessionDefinition   ConcessionDefinition @relation(fields: [concessionDefinitionId], references: [id])
  studentId              String
  student                StudentProfile       @relation(fields: [studentId], references: [id])
  totalPaise             BigInt
  approvedByUserId       String // recorded actor id (no FK)
  note                   String?
  postedAt               DateTime             @default(now())
  createdAt              DateTime             @default(now())

  credits ConcessionCredit[]

  // INSERT-only append-only ledger header (NO updatedAt): append-only RLS +
  // REVOKE UPDATE,DELETE + trigger are hand-authored in the migration. Composite
  // same-tenant FKs (concessionDefinitionId->concession_definitions,
  // studentId->student_profiles) + CHECK totalPaise > 0 are raw SQL.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, studentId])
  @@map("student_concessions")
}

model ConcessionCredit {
  id                  String            @id @default(cuid())
  institutionId       String
  institution         Institution       @relation(fields: [institutionId], references: [id])
  studentConcessionId String
  studentConcession   StudentConcession @relation(fields: [studentConcessionId], references: [id])
  studentChargeId     String
  studentCharge       StudentCharge     @relation(fields: [studentChargeId], references: [id])
  amountPaise         BigInt
  currency            String            @default("INR")
  createdAt           DateTime          @default(now())

  // INSERT-only (NO updatedAt): append-only RLS + REVOKE UPDATE,DELETE +
  // trigger hand-authored in the migration. Composite same-tenant FKs
  // (studentConcessionId->student_concessions, studentChargeId->student_charges)
  // + CHECKs (amountPaise > 0, currency = 'INR') are raw SQL.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, studentChargeId])
  @@map("concession_credits")
}

model Refund {
  id                   String             @id @default(cuid())
  institutionId        String
  institution          Institution        @relation(fields: [institutionId], references: [id])
  paymentTransactionId String
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id])
  studentId            String
  student              StudentProfile     @relation(fields: [studentId], references: [id])
  amountPaise          BigInt
  currency             String             @default("INR")
  status               RefundStatus       @default(REQUESTED)
  reason               String
  razorpayRefundId     String?
  idempotencyKey       String
  approvedByUserId     String // recorded actor id (no FK)
  requestedAt          DateTime           @default(now())
  settledAt            DateTime?
  unreversiblePaise    BigInt             @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  reversals RefundReversal[]

  // Mutable FACT with a column-guard (like payment_transactions): money/identity
  // columns freeze, status is forward-only REQUESTED->{PROCESSED,FAILED}, DELETE
  // raises. The @@unique([razorpayRefundId]) here is the FULL unique; the
  // migration DROPs it and recreates it as a PARTIAL unique WHERE
  // razorpayRefundId IS NOT NULL (the known cosmetic migrate-diff). The
  // idempotencyKey global unique, composite same-tenant FKs
  // (paymentTransactionId->payment_transactions, studentId->student_profiles),
  // CHECKs (amountPaise > 0, currency = 'INR', char_length(reason) >= 1,
  // unreversiblePaise >= 0), RLS, and refunds_guard are raw SQL in the migration.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@unique([razorpayRefundId]) // migration replaces with a partial unique
  @@unique([idempotencyKey]) // request-time correlation key (HIGH-2)
  @@index([institutionId])
  @@index([institutionId, paymentTransactionId])
  @@index([institutionId, status])
  @@map("refunds")
}

model RefundReversal {
  id              String        @id @default(cuid())
  institutionId   String
  institution     Institution   @relation(fields: [institutionId], references: [id])
  refundId        String
  refund          Refund        @relation(fields: [refundId], references: [id])
  studentChargeId String
  studentCharge   StudentCharge @relation(fields: [studentChargeId], references: [id])
  amountPaise     BigInt
  currency        String        @default("INR")
  createdAt       DateTime      @default(now())

  // INSERT-only (NO updatedAt): append-only RLS + REVOKE UPDATE,DELETE +
  // trigger hand-authored in the migration. Composite same-tenant FKs
  // (refundId->refunds, studentChargeId->student_charges) + CHECKs
  // (amountPaise > 0, currency = 'INR') are raw SQL.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, studentChargeId])
  @@map("refund_reversals")
}

model Adjustment {
  id               String         @id @default(cuid())
  institutionId    String
  institution      Institution    @relation(fields: [institutionId], references: [id])
  studentId        String
  student          StudentProfile @relation(fields: [studentId], references: [id])
  studentChargeId  String
  studentCharge    StudentCharge  @relation(fields: [studentChargeId], references: [id])
  type             AdjustmentType
  direction        String // 'CREDIT' | 'DEBIT' (CHECK in migration)
  amountPaise      BigInt
  currency         String         @default("INR")
  reason           String
  approvedByUserId String // recorded actor id (no FK)
  postedAt         DateTime       @default(now())
  createdAt        DateTime       @default(now())

  // INSERT-only append-only ledger entry (NO updatedAt): append-only RLS +
