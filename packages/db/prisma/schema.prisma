// ─── SESSION & DEVICE SECURITY ──────────────────────────────────────────────

model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Stores the JWT jti claim — revoke by marking this row revoked
  jti          String    @unique
