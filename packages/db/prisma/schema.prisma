  nonTeachingHours Int            @default(0) // admin/research etc. (staff-entered)
  totalHours       Int // computed = teaching + nonTeaching (persisted for query + audit)
  overAllocated    Boolean        @default(false) // total > policy max
  overrideReason   String? // set when staff deliberately exceed the max
  lastReconciledAt DateTime? // when teachingHours was last derived from assignments
  updatedByUserId  String // recorded actor id, NO FK
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Mutable (recompute-audited). Standard RLS pair; composite same-tenant FKs
  // (institutionId, facultyId)->faculty_profiles, (institutionId, academicTermId)
  // ->academic_terms, and CHECKs (totalHours = teachingHours + nonTeachingHours;
  // teachingHours >= 0; nonTeachingHours >= 0) are raw SQL in the migration.
  @@unique([institutionId, facultyId, academicTermId]) // one workload row per faculty per term
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, facultyId])
  @@index([institutionId, academicTermId])
  @@map("faculty_workloads")
}

model FacultyTeachingHistory {
  id                 String                           @id @default(cuid())
  institutionId      String
  institution        Institution                      @relation(fields: [institutionId], references: [id])
  facultyId          String
  faculty            FacultyProfile                   @relation(fields: [facultyId], references: [id])
  subjectId          String
  subject            Subject                          @relation(fields: [subjectId], references: [id])
  classSectionId     String?
  classSection       ClassSection?                    @relation(fields: [classSectionId], references: [id])
  academicTermId     String
  academicTerm       AcademicTerm                     @relation(fields: [academicTermId], references: [id])
  sourceAssignmentId String? // recorded FacultyAssignment id, NO FK (assignment is mutable; decoupling)
  role               FacultyAssignmentRole
  changeType         FacultyTeachingHistoryChangeType // ASSIGNED | ENDED
  effectiveAt        DateTime // assignedAt (ASSIGNED) or endedAt (ENDED)
  recordedByUserId   String // recorded actor id, NO FK
  createdAt          DateTime                         @default(now())

  // STRICTLY append-only (the marks_record_history precedent): createdAt only (no
  // updatedAt). Append-only RLS pair {tenant_isolation_select,
  // faculty_teaching_history_tenant_insert} + the unconditional-raise
  // faculty_teaching_history_no_update_delete BEFORE UPDATE OR DELETE trigger +
  // composite same-tenant FKs ((institutionId, facultyId)->faculty_profiles,
  // (institutionId, subjectId)->subjects, (institutionId, classSectionId)->
  // class_sections, (institutionId, academicTermId)->academic_terms) are raw SQL.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, facultyId])
  @@index([institutionId, facultyId, academicTermId])
  @@map("faculty_teaching_history")
}

enum FacultyQualificationKind {
  DEGREE
  CERTIFICATION
  DIPLOMA
  OTHER
}

enum FacultyTeachingHistoryChangeType {
  ASSIGNED
  ENDED
}

// ΓöÇΓöÇΓöÇ PHASE 9.2 HR MANAGEMENT ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// Eight tenant-owned tables (design PART B ┬º4). Prisma models reference single
// PKs; the composite same-tenant FK VARIANTS, CHECKs, RLS policies and column-
// guard / append-only triggers are raw SQL in the migration (the
// faculty_management convention). institutionId / (id, institutionId) /
// (institutionId) index on every table.

model HrEmployee {
  id              String             @id @default(cuid())
  institutionId   String
  institution     Institution        @relation(fields: [institutionId], references: [id])
  userId          String
  user            User               @relation(fields: [userId], references: [id])
  employeeNo      String // unique per tenant
  designation     String?
  employmentType  HrEmploymentType
  departmentId    String?
  department      Department?        @relation(fields: [departmentId], references: [id])
  joiningDate     DateTime
  status          HrEmployeeStatus   @default(ACTIVE)
  createdByUserId String // recorded actor id, NO FK
  updatedByUserId String // recorded actor id, NO FK
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  contracts  HrContract[]
  leaveApps  HrLeaveApplication[]
  attendance HrEmployeeAttendance[]

  // Mutable (editable-with-audit); no trigger. Composite same-tenant FKs
  // (institutionId, userId)->users, (institutionId, departmentId)->departments
  // and CHECK char_length(employeeNo) >= 1 are raw SQL in the migration.
  @@unique([institutionId, userId]) // one employee per user per tenant
  @@unique([institutionId, employeeNo]) // employeeNo unique per tenant
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, departmentId])
  @@map("hr_employees")
}

model HrContract {
  id                   String             @id @default(cuid())
  institutionId        String
  institution          Institution        @relation(fields: [institutionId], references: [id])
  employeeId           String
  employee             HrEmployee         @relation(fields: [employeeId], references: [id])
  contractType         HrContractType
  startDate            DateTime
  endDate              DateTime?
  termsMetadata        Json?
  salaryAmount         BigInt? // minor units, metadata only ΓÇö NO fees integration
  currency             String             @default("INR")
  status               HrContractStatus   @default(ACTIVE)
  supersedesContractId String? // recorded id, NO FK (the decoupling precedent)
  createdByUserId      String // recorded actor id, NO FK
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // Versioned-append with a column guard (┬º4.2): identity/economic columns
  // frozen; status forward-only ACTIVE->ENDED|SUPERSEDED; no DELETE. Composite
  // same-tenant FK (institutionId, employeeId)->hr_employees, CHECKs
  // (currency = 'INR'; salaryAmount IS NULL OR salaryAmount >= 0) and the
  // hr_contracts_guard() trigger are raw SQL in the migration.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, employeeId])
  @@map("hr_contracts")
}

model HrLeavePolicy {
  id              String        @id @default(cuid())
  institutionId   String
  institution     Institution   @relation(fields: [institutionId], references: [id])
  leaveType       HrLeaveType
  annualQuotaDays Int
  accrualRule     HrAccrualRule @default(ANNUAL_LUMP_SUM)
  active          Boolean       @default(true)
  updatedByUserId String // recorded actor id, NO FK
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Mutable config (editable-with-audit); no trigger. CHECK annualQuotaDays >= 0
  // is raw SQL in the migration.
  @@unique([institutionId, leaveType]) // one policy per leave type per tenant
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@map("hr_leave_policies")
}

model HrLeaveApplication {
  id               String                   @id @default(cuid())
  institutionId    String
  institution      Institution              @relation(fields: [institutionId], references: [id])
  employeeId       String
  employee         HrEmployee               @relation(fields: [employeeId], references: [id])
  leaveType        HrLeaveType
  startDate        DateTime
  endDate          DateTime
  days             Int // derived server-side (inclusive endpoints)
  periodYear       Int // calendar year of startDate (accrual period)
  reason           String
  status           HrLeaveApplicationStatus @default(REQUESTED)
  reviewedByUserId String? // recorded actor id, NO FK
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  // Forward-only lifecycle via a column guard (┬º4.3): immutable columns frozen;
  // REQUESTED->APPROVED|REJECTED|CANCELLED only; no DELETE. Composite same-tenant
  // FK (institutionId, employeeId)->hr_employees, CHECKs (days >= 1;
  // endDate >= startDate; char_length(reason) >= 1) and the
  // hr_leave_applications_guard() trigger are raw SQL in the migration.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, employeeId])
  @@index([institutionId, employeeId, leaveType, periodYear]) // balance aggregate
  @@index([institutionId, status]) // staff queue by status
  @@map("hr_leave_applications")
}

model HrShift {
  id              String                 @id @default(cuid())
  institutionId   String
  institution     Institution            @relation(fields: [institutionId], references: [id])
  name            String
  startMinute     Int
  endMinute       Int
  active          Boolean                @default(true)
  updatedByUserId String // recorded actor id, NO FK
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  attendance HrEmployeeAttendance[]

  // Mutable config (editable-with-audit); no trigger. CHECK startMinute/endMinute
  // in 0..1439 is raw SQL in the migration.
  @@unique([institutionId, name]) // one shift name per tenant
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@map("hr_shifts")
}

model HrEmployeeAttendance {
  id               String                        @id @default(cuid())
  institutionId    String
  institution      Institution                   @relation(fields: [institutionId], references: [id])
  employeeId       String
  employee         HrEmployee                    @relation(fields: [employeeId], references: [id])
  attendanceDate   DateTime                      @db.Date
  status           HrAttendanceStatus
  source           HrAttendanceSource            @default(MANUAL)
  shiftId          String?
  shift            HrShift?                      @relation(fields: [shiftId], references: [id])
  recordedByUserId String // recorded actor id, NO FK
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  history HrEmployeeAttendanceHistory[]

  // Mutable current state (editable-with-audit); correction writes an immutable
  // history row. No trigger on this table. Composite same-tenant FKs
  // (institutionId, employeeId)->hr_employees, (institutionId, shiftId)->hr_shifts
  // are raw SQL in the migration.
  @@unique([institutionId, employeeId, attendanceDate]) // one record per employee per day
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, employeeId])
  @@map("hr_employee_attendance")
}

model HrEmployeeAttendanceHistory {
  id                   String                          @id @default(cuid())
  institutionId        String
  institution          Institution                     @relation(fields: [institutionId], references: [id])
  employeeAttendanceId String
  employeeAttendance   HrEmployeeAttendance            @relation(fields: [employeeAttendanceId], references: [id])
  changeType           HrAttendanceHistoryChangeType
  previousStatus       HrAttendanceStatus?
  newStatus            HrAttendanceStatus
  actorUserId          String // recorded actor id, NO FK
  reason               String?
  metadata             Json?
  createdAt            DateTime                        @default(now())

  // STRICTLY append-only (the attendance_record_history precedent): createdAt
  // only (no updatedAt). Append-only RLS pair {tenant_isolation_select,
  // hr_employee_attendance_history_tenant_insert} + the unconditional-raise
  // hr_employee_attendance_history_append_only() BEFORE UPDATE OR DELETE trigger +
  // composite same-tenant FK (institutionId, employeeAttendanceId)->
  // hr_employee_attendance are raw SQL in the migration.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, employeeAttendanceId])
  @@map("hr_employee_attendance_history")
}

enum HrEmploymentType {
  PERMANENT
  CONTRACT
  PART_TIME
}

enum HrEmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum HrContractType {
  PERMANENT
  FIXED_TERM
  PROBATION
  CONSULTANT
}

enum HrContractStatus {
  ACTIVE
  ENDED
  SUPERSEDED
}

enum HrLeaveType {
  CASUAL
  SICK
  EARNED
  UNPAID
  OTHER
}

enum HrAccrualRule {
  ANNUAL_LUMP_SUM
  MONTHLY_ACCRUAL
}

enum HrLeaveApplicationStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum HrAttendanceStatus {
  PRESENT
  ABSENT
  ON_LEAVE
  HALF_DAY
}

enum HrAttendanceSource {
  MANUAL
  DERIVED
}

enum HrAttendanceHistoryChangeType {
  RECORDED
  CORRECTED
}


// ΓöÇΓöÇΓöÇ HOSTEL MANAGEMENT (Phase 9.3, tenant-owned) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// Backend-only gated "booster" module (design ┬ºB). Six tenant-owned tables
// anchored on StudentProfile via composite same-tenant FKs. Prisma models carry
// ONLY the field/index shape; composite same-tenant FKs, RLS (ENABLE+FORCE),
// CHECKs, the forward-only column-guard + append-only triggers, the campass_app
// GRANT refresh, and the catalogue seed all live in the hand-authored migration
// 20270103000000_phase9_hostel. Actor/provenance ids (wardenUserId,
// createdByUserId, allocatedByUserId, recordedByUserId, reportedByUserId,
// assigneeUserId, transferFromAllocationId) are recorded ids with NO FK (the
// faculty createdByUserId/recordedByUserId precedent, assumption A1).

model HostelBuilding {
  id              String             @id @default(cuid())
  institutionId   String
  institution     Institution        @relation(fields: [institutionId], references: [id])
  name            String
  type            HostelBuildingType
  wardenUserId    String? // recorded actor id, NO FK (assumption A1)
  isActive        Boolean            @default(true) // building active flag (FR-1.1); NOT a multi-state status enum
  createdByUserId String // recorded actor id, NO FK
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  rooms HostelRoom[]

  // Mutable-with-audit (no immutability trigger). Standard RLS pair; business
  // unique (institutionId, name) + CHECK char_length(name) >= 1 are raw SQL.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@map("hostel_buildings")
}

model HostelRoom {
  id              String           @id @default(cuid())
  institutionId   String
  institution     Institution      @relation(fields: [institutionId], references: [id])
  buildingId      String
  building        HostelBuilding   @relation(fields: [buildingId], references: [id])
  roomNumber      String
  capacity        Int // CHECK capacity >= 1 (raw SQL)
  floor           Int?
  status          HostelRoomStatus @default(AVAILABLE) // manual staff flag only, never auto-derived from occupancy (FR-1.2)
  createdByUserId String // recorded actor id, NO FK
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  allocations        HostelRoomAllocation[]
  maintenanceRequests HostelMaintenanceRequest[]

  // Mutable-with-audit. Standard RLS pair; composite same-tenant FK
  // (institutionId, buildingId)->hostel_buildings, business unique
  // (institutionId, buildingId, roomNumber), CHECK capacity >= 1 are raw SQL.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, buildingId])
  @@map("hostel_rooms")
}

model HostelRoomAllocation {
  id                       String                 @id @default(cuid())
  institutionId            String
  institution              Institution            @relation(fields: [institutionId], references: [id])
  roomId                   String
  room                     HostelRoom             @relation(fields: [roomId], references: [id])
  studentId                String
  student                  StudentProfile         @relation(fields: [studentId], references: [id])
  status                   HostelAllocationStatus @default(ACTIVE)
  allocatedAt              DateTime
  vacatedAt                DateTime? // set on VACATED/TRANSFERRED
  allocatedByUserId        String // recorded actor id, NO FK
  transferFromAllocationId String? // provenance link, write-once at INSERT, NO FK
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  checkEvents HostelCheckEvent[]

  // Forward-only lifecycle (ACTIVE->VACATED|TRANSFERRED). Standard RLS pair +
  // column-guard trigger hostel_room_allocations_guard + composite same-tenant
  // FKs ((institutionId, roomId)->hostel_rooms, (institutionId, studentId)->
  // student_profiles) + the partial unique one-ACTIVE-per-student are raw SQL.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, roomId])
  @@index([institutionId, studentId])
  @@map("hostel_room_allocations")
}

model HostelCheckEvent {
  id               String                @id @default(cuid())
  institutionId    String
  institution      Institution           @relation(fields: [institutionId], references: [id])
  allocationId     String
  allocation       HostelRoomAllocation  @relation(fields: [allocationId], references: [id])
  studentId        String
  student          StudentProfile        @relation(fields: [studentId], references: [id])
  eventType        HostelCheckEventType
  occurredAt       DateTime
  recordedByUserId String // recorded actor id, NO FK
  createdAt        DateTime              @default(now())

  // STRICTLY append-only (the marks_record_history precedent): createdAt only (no
  // updatedAt). Append-only RLS pair + hostel_check_events_append_only trigger +
  // composite same-tenant FKs ((institutionId, allocationId)->
  // hostel_room_allocations, (institutionId, studentId)->student_profiles) raw SQL.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, allocationId])
  @@index([institutionId, studentId])
  @@map("hostel_check_events")
}

model HostelLeaveApplication {
  id              String            @id @default(cuid())
  institutionId   String
  institution     Institution       @relation(fields: [institutionId], references: [id])
  studentId       String
  student         StudentProfile    @relation(fields: [studentId], references: [id])
  fromDate        DateTime
  toDate          DateTime // CHECK toDate >= fromDate (raw SQL)
  reason          String // CHECK char_length(reason) >= 1 (raw SQL)
  status          HostelLeaveStatus @default(REQUESTED)
  appliedByUserId String // the student's user id (recorded actor id, NO FK)
  decidedByUserId String? // warden/admin on APPROVE/REJECT
  decidedAt       DateTime?
  decisionNote    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Forward-only lifecycle (REQUESTED->APPROVED|REJECTED|CANCELLED). Standard RLS
  // pair + column-guard trigger hostel_leave_applications_guard + composite
  // same-tenant FK (institutionId, studentId)->student_profiles are raw SQL.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, studentId])
  @@index([institutionId, status])
  @@map("hostel_leave_applications")
}

model HostelMaintenanceRequest {
  id               String                  @id @default(cuid())
  institutionId    String
  institution      Institution             @relation(fields: [institutionId], references: [id])
  roomId           String
  room             HostelRoom              @relation(fields: [roomId], references: [id])
  issue            String // CHECK char_length(issue) >= 1 (raw SQL)
  status           HostelMaintenanceStatus @default(OPEN)
  assigneeUserId   String? // recorded actor id, NO FK (assumption A1)
  reportedByUserId String // recorded actor id, NO FK
  resolvedAt       DateTime? // set on RESOLVED
  resolutionNote   String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  // Forward-only lifecycle (OPEN->IN_PROGRESS->RESOLVED, OPEN|IN_PROGRESS->
  // CANCELLED). Standard RLS pair + column-guard trigger
  // hostel_maintenance_requests_guard + composite same-tenant FK
  // (institutionId, roomId)->hostel_rooms are raw SQL.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, roomId])
  @@index([institutionId, status])
  @@map("hostel_maintenance_requests")
}

enum HostelBuildingType {
  BOYS
  GIRLS
  MIXED
  STAFF
}

enum HostelRoomStatus {
  AVAILABLE
  FULL
  MAINTENANCE
  CLOSED
}

enum HostelAllocationStatus {
  ACTIVE
  VACATED
  TRANSFERRED
}

enum HostelCheckEventType {
  CHECK_IN
  CHECK_OUT
}

enum HostelLeaveStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum HostelMaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}


// ─── TRANSPORT MANAGEMENT (Phase 9.4, tenant-owned) ─────────────────────────
// Backend-only gated "booster" module (design §B). Eight tenant-owned tables.
// transport_enrollments anchors on StudentProfile via a composite same-tenant
// FK. Prisma models carry ONLY the field/index shape; composite same-tenant
// FKs, RLS (ENABLE+FORCE), CHECKs, the forward-only column-guard triggers, the
// campass_app GRANT refresh, and the catalogue seed all live in the
// hand-authored migration 20270110000000_phase9_transport. Actor/provenance ids
// (createdByUserId, reportedByUserId, assigneeUserId, userId) are recorded ids
// with NO FK (the hostel/faculty createdByUserId precedent).

model TransportVehicle {
  id              String                 @id @default(cuid())
  institutionId   String
  institution     Institution            @relation(fields: [institutionId], references: [id])
  registrationNo  String // CHECK char_length(registrationNo) >= 1 (raw SQL)
  type            TransportVehicleType
  seatCapacity    Int // CHECK seatCapacity >= 1 (raw SQL)
  status          TransportVehicleStatus @default(ACTIVE)
  createdByUserId String // recorded actor id, NO FK
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  routeAssignments    TransportRouteAssignment[]
  maintenanceRequests TransportVehicleMaintenanceRequest[]

  // Mutable-with-audit (no immutability trigger). Standard RLS pair; business
  // unique (institutionId, registrationNo) + CHECKs are raw SQL.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@map("transport_vehicles")
}

model TransportDriver {
  id              String                @id @default(cuid())
  institutionId   String
  institution     Institution           @relation(fields: [institutionId], references: [id])
  name            String // CHECK char_length(name) >= 1 (raw SQL)
  licenseNo       String // CHECK char_length(licenseNo) >= 1 (raw SQL)
  phone           String?
  userId          String? // recorded actor id, NO FK
  status          TransportDriverStatus @default(ACTIVE)
  createdByUserId String // recorded actor id, NO FK
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  routeAssignments TransportRouteAssignment[]

  // Mutable-with-audit (no immutability trigger). Standard RLS pair; business
  // unique (institutionId, licenseNo) + CHECKs are raw SQL.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@map("transport_drivers")
}

model TransportRoute {
  id              String               @id @default(cuid())
  institutionId   String
  institution     Institution          @relation(fields: [institutionId], references: [id])
  name            String // CHECK char_length(name) >= 1 (raw SQL)
  code            String // CHECK char_length(code) >= 1 (raw SQL)
  status          TransportRouteStatus @default(ACTIVE)
  feeAmount       Int? // int paise; CHECK feeAmount >= 0 (raw SQL)
  createdByUserId String // recorded actor id, NO FK
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  stops           TransportRouteStop[]
  assignments     TransportRouteAssignment[]
  enrollments     TransportEnrollment[]
  schedules       TransportRouteSchedule[]

  // Mutable-with-audit (no immutability trigger). Standard RLS pair; business
  // unique (institutionId, code) + CHECKs are raw SQL.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@map("transport_routes")
}

model TransportRouteStop {
  id                  String         @id @default(cuid())
  institutionId       String
  institution         Institution    @relation(fields: [institutionId], references: [id])
  routeId             String
  route               TransportRoute @relation(fields: [routeId], references: [id])
  name                String // CHECK char_length(name) >= 1 (raw SQL)
  sequence            Int // CHECK sequence >= 1 (raw SQL)
  landmark            String?
  latitude            Float?
  longitude           Float?
  pickupOffsetMinutes Int? // CHECK pickupOffsetMinutes >= 0 (raw SQL)
  createdByUserId     String // recorded actor id, NO FK
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  enrollments TransportEnrollment[]
  schedules   TransportRouteSchedule[]

  // Mutable-with-audit (no immutability trigger). Standard RLS pair; business
  // unique (institutionId, routeId, sequence) + composite same-tenant FK
  // (institutionId, routeId)->transport_routes + CHECKs are raw SQL.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, routeId])
  @@map("transport_route_stops")
}

model TransportRouteAssignment {
  id              String                   @id @default(cuid())
  institutionId   String
  institution     Institution              @relation(fields: [institutionId], references: [id])
  routeId         String
  route           TransportRoute           @relation(fields: [routeId], references: [id])
  vehicleId       String
  vehicle         TransportVehicle         @relation(fields: [vehicleId], references: [id])
  driverId        String
  driver          TransportDriver          @relation(fields: [driverId], references: [id])
  effectiveFrom   DateTime
  effectiveTo     DateTime? // CHECK effectiveTo IS NULL OR effectiveTo >= effectiveFrom (raw SQL)
  status          TransportAssignmentStatus @default(ACTIVE)
  createdByUserId String // recorded actor id, NO FK
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  // Forward-only lifecycle (ACTIVE->ENDED). Standard RLS pair + column-guard
  // trigger transport_route_assignments_guard + composite same-tenant FKs
  // ((institutionId, routeId)->transport_routes, (institutionId, vehicleId)->
  // transport_vehicles, (institutionId, driverId)->transport_drivers) + the
  // partial unique one-ACTIVE-per-route are raw SQL.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, routeId])
  @@index([institutionId, vehicleId])
  @@map("transport_route_assignments")
}

model TransportEnrollment {
  id              String                    @id @default(cuid())
  institutionId   String
  institution     Institution               @relation(fields: [institutionId], references: [id])
  studentId       String
  student         StudentProfile            @relation(fields: [studentId], references: [id])
  routeId         String
  route           TransportRoute            @relation(fields: [routeId], references: [id])
  stopId          String
  stop            TransportRouteStop        @relation(fields: [stopId], references: [id])
  status          TransportEnrollmentStatus @default(ACTIVE)
  enrolledAt      DateTime
  endedAt         DateTime? // set on ENDED
  createdByUserId String // recorded actor id, NO FK
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  // Forward-only lifecycle (ACTIVE->SUSPENDED|ENDED, SUSPENDED->ENDED). Standard
  // RLS pair + column-guard trigger transport_enrollments_guard + composite
  // same-tenant FKs ((institutionId, studentId)->student_profiles,
  // (institutionId, routeId)->transport_routes, (institutionId, stopId)->
  // transport_route_stops) + the partial unique one-ACTIVE-per-student-route
  // are raw SQL.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, routeId])
  @@index([institutionId, studentId])
  @@map("transport_enrollments")
}

model TransportVehicleMaintenanceRequest {
  id               String                     @id @default(cuid())
  institutionId    String
  institution      Institution                @relation(fields: [institutionId], references: [id])
  vehicleId        String
  vehicle          TransportVehicle           @relation(fields: [vehicleId], references: [id])
  issue            String // CHECK char_length(issue) >= 1 (raw SQL)
  status           TransportMaintenanceStatus @default(OPEN)
  assigneeUserId   String? // recorded actor id, NO FK
  cost             Int? // int paise; CHECK cost >= 0 (raw SQL)
  reportedByUserId String // recorded actor id = creator (NO createdByUserId), NO FK
  resolutionNote   String?
  resolvedAt       DateTime? // set on RESOLVED
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  // Forward-only lifecycle (OPEN->IN_PROGRESS->RESOLVED, OPEN|IN_PROGRESS->
  // CANCELLED). DELIBERATELY NO createdByUserId — reportedByUserId is the creator
  // actor, mirroring hostel_maintenance_requests. Standard RLS pair + column-guard
  // trigger transport_vehicle_maintenance_requests_guard + composite same-tenant
  // FK (institutionId, vehicleId)->transport_vehicles are raw SQL.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, vehicleId])
  @@index([institutionId, status])
  @@map("transport_vehicle_maintenance_requests")
}

model TransportRouteSchedule {
  id              String              @id @default(cuid())
  institutionId   String
  institution     Institution         @relation(fields: [institutionId], references: [id])
  routeId         String
  route           TransportRoute      @relation(fields: [routeId], references: [id])
  stopId          String?
  stop            TransportRouteStop? @relation(fields: [stopId], references: [id])
  dayOfWeek       TransportDayOfWeek? // exactly-one-of dayOfWeek/date (raw SQL CHECK)
  date            DateTime?
  departureTime   Int // minutes-of-day; CHECK 0..1439 (raw SQL)
  arrivalTime     Int? // minutes-of-day; CHECK 0..1439 (raw SQL)
  createdByUserId String // recorded actor id, NO FK
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // Mutable-with-audit (no immutability trigger). Standard RLS pair + composite
  // same-tenant FKs ((institutionId, routeId)->transport_routes, (institutionId,
  // stopId)->transport_route_stops; NULL stopId is a no-op via MATCH SIMPLE) +
  // CHECKs are raw SQL.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@index([institutionId])
  @@index([institutionId, routeId])
  @@map("transport_route_schedules")
}

