generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  HOD
  GUARD
  ADMIN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  PENDING_APPROVAL
}

enum PassStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  OUTSIDE
  COMPLETED
  CANCELLED
  EXPIRED
  REVOKED
}

enum GateEventType {
  EXIT
  RETURN
}

enum AuditAction {
  PASS_REQUESTED
  PASS_APPROVED
  PASS_REJECTED
  PASS_CANCELLED
  PASS_REVOKED
  PASS_EXPIRED
  GATE_EXIT
  GATE_RETURN
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  USER_REACTIVATED
  GATE_CREATED
  GATE_UPDATED
  DEPARTMENT_CREATED
  DEPARTMENT_UPDATED
  REASON_CREATED
  REASON_UPDATED
  BULK_IMPORT
  EMERGENCY_OVERRIDE
  ALLOWANCE_POLICY_UPDATED
}

enum PolicyPeriod {
  DAILY
  WEEKLY
  MONTHLY
  SEMESTER
}

enum EnforcementMode {
  BLOCK_NEW_REQUESTS
  WARN_ONLY
}

enum SeverityLevel {
  MINOR
  MODERATE
  SIGNIFICANT
  SEVERE
}

// ─── INSTITUTION (future multi-tenancy) ─────────────────────────────────────

model Institution {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  domain    String?
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments     Department[]
  gates           Gate[]
  users           User[]
  exitReasons     ExitReason[]
  allowancePolicy AllowancePolicy?

  @@map("institutions")
}

// ─── DEPARTMENT ─────────────────────────────────────────────────────────────

model Department {
  id            String      @id @default(cuid())
  name          String
  code          String
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  students StudentProfile[]
  hods     HodProfile[]

  @@unique([institutionId, code])
  @@map("departments")
}

// ─── USER (unified auth) ────────────────────────────────────────────────────

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String?
  googleId      String?       @unique
  role          Role
  accountStatus AccountStatus @default(ACTIVE)
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lastLoginAt   DateTime?

  studentProfile StudentProfile?
  hodProfile     HodProfile?
  guardProfile   GuardProfile?

  // Audit trail
  auditLogs          AuditLog[]          @relation("AuditActor")
  emergencyOverrides EmergencyOverride[] @relation("OverrideActor")

  @@map("users")
}

// ─── STUDENT PROFILE ────────────────────────────────────────────────────────

model StudentProfile {
  id           String     @id @default(cuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id])
  enrollmentNo String     @unique
  rollNumber   String?
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  program      String
  semester     Int
  section      String?
  dob          String?
  phone        String?
  address      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  gatePasses           GatePass[]
  reliabilitySnapshots ReliabilityScoreSnapshot[]

  @@map("student_profiles")
}

// ─── HOD PROFILE ────────────────────────────────────────────────────────────

model HodProfile {
  id           String     @id @default(cuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id])
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  approvedPasses GatePass[] @relation("ApprovedBy")

  @@map("hod_profiles")
}

// ─── GUARD PROFILE ──────────────────────────────────────────────────────────

model GuardProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedGates GuardGateAssignment[]
  gateEvents    GateEvent[]

  @@map("guard_profiles")
}

// ─── GATE ───────────────────────────────────────────────────────────────────

model Gate {
  id            String      @id @default(cuid())
  name          String
  location      String?
  isActive      Boolean     @default(true)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  assignedGuards GuardGateAssignment[]
  gateEvents     GateEvent[]

  @@unique([institutionId, name])
  @@map("gates")
}

// ─── GUARD ↔ GATE (many-to-many) ───────────────────────────────────────────

model GuardGateAssignment {
  id        String       @id @default(cuid())
  guardId   String
  guard     GuardProfile @relation(fields: [guardId], references: [id])
  gateId    String
  gate      Gate         @relation(fields: [gateId], references: [id])
  createdAt DateTime     @default(now())

  @@unique([guardId, gateId])
  @@map("guard_gate_assignments")
}

// ─── EXIT REASONS (configurable) ────────────────────────────────────────────

model ExitReason {
  id            String      @id @default(cuid())
  label         String
  requiresNote  Boolean     @default(false)
  isActive      Boolean     @default(true)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  gatePasses GatePass[]

  @@map("exit_reasons")
}

// ─── GATE PASS (core entity) ────────────────────────────────────────────────

model GatePass {
  id             String         @id @default(cuid())
  passNumber     String         @unique
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id])
  reasonId       String
  reason         ExitReason     @relation(fields: [reasonId], references: [id])
  customReason   String?
  requestedExit  DateTime
  expectedReturn DateTime
  status         PassStatus     @default(PENDING)

  // Approval
  approvedById    String?
  approvedBy      HodProfile? @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?

  // QR token
  qrToken     String?   @unique
  qrExpiresAt DateTime?

  // Actual times
  actualExit     DateTime?
  actualReturn   DateTime?
  overdueMinutes Int?

  // Allowance warning (set when pass created under warn_only with exhausted allowance)
  allowanceWarning String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gateEvents        GateEvent[]
  emergencyOverride EmergencyOverride?

  @@index([studentId, status])
  @@index([status, createdAt])
  @@map("gate_passes")
}

// ─── GATE EVENTS ────────────────────────────────────────────────────────────

model GateEvent {
  id        String        @id @default(cuid())
  passId    String
  pass      GatePass      @relation(fields: [passId], references: [id])
  gateId    String
  gate      Gate          @relation(fields: [gateId], references: [id])
  guardId   String
  guard     GuardProfile  @relation(fields: [guardId], references: [id])
  eventType GateEventType
  timestamp DateTime      @default(now())
  method    String        @default("QR_SCAN")

  @@index([passId, eventType])
  @@map("gate_events")
}

// ─── AUDIT LOG ──────────────────────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String
  actor      User        @relation("AuditActor", fields: [actorId], references: [id])
  action     AuditAction
  targetId   String?
  targetType String?
  metadata   Json?
  timestamp  DateTime    @default(now())

  @@index([actorId, timestamp])
  @@index([action, timestamp])
  @@map("audit_logs")
}

// ─── NOTIFICATIONS ──────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
  @@map("notifications")
}

// ─── ALLOWANCE POLICY ───────────────────────────────────────────────────────

model AllowancePolicy {
  id                     String          @id @default(cuid())
  institutionId          String          @unique
  institution            Institution     @relation(fields: [institutionId], references: [id])
  allowanceAmount        Int             @default(1440) // minutes, [60, 10080]
  policyPeriod           PolicyPeriod    @default(WEEKLY)
  gracePeriod            Int             @default(10) // minutes, [0, 60]
  enforcement            EnforcementMode @default(WARN_ONLY)
  minimumSampleSize      Int             @default(5) // [3, 20]
  severityMinorMax       Int             @default(15)
  severityModerateMax    Int             @default(60)
  severitySignificantMax Int             @default(180)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@map("allowance_policies")
}

// ─── EMERGENCY OVERRIDE ─────────────────────────────────────────────────────

model EmergencyOverride {
  id             String   @id @default(cuid())
  gatePassId     String   @unique
  gatePass       GatePass @relation(fields: [gatePassId], references: [id])
  overriddenById String
  overriddenBy   User     @relation("OverrideActor", fields: [overriddenById], references: [id])
  justification  String // min 10 characters
  createdAt      DateTime @default(now())

  @@map("emergency_overrides")
}

// ─── RELIABILITY SCORE SNAPSHOT ─────────────────────────────────────────────

model ReliabilityScoreSnapshot {
  id             String         @id @default(cuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id])
  score          Float // 0.0–5.0
  movementNumber Int // sequential movement count at time of snapshot
  computedAt     DateTime       @default(now())

  @@index([studentId, computedAt])
  @@map("reliability_score_snapshots")
}
