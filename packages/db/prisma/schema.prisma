model Refund {
  id                   String             @id @default(cuid())
  institutionId        String
  institution          Institution        @relation(fields: [institutionId], references: [id])
  paymentTransactionId String
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id])
  studentId            String
  student              StudentProfile     @relation(fields: [studentId], references: [id])
  amountPaise          BigInt
  currency             String             @default("INR")
  status               RefundStatus       @default(REQUESTED)
  reason               String
  razorpayRefundId     String?
  idempotencyKey       String
  approvedByUserId     String // recorded actor id (no FK)
  requestedAt          DateTime           @default(now())
  settledAt            DateTime?
  unreversiblePaise    BigInt             @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  reversals RefundReversal[]

  // Mutable FACT with a column-guard (like payment_transactions): money/identity
  // columns freeze, status is forward-only REQUESTED->{PROCESSED,FAILED}, DELETE
  // raises. The @@unique([razorpayRefundId]) here is the FULL unique; the
  // migration DROPs it and recreates it as a PARTIAL unique WHERE
  // razorpayRefundId IS NOT NULL (the known cosmetic migrate-diff). The
  // idempotencyKey global unique, composite same-tenant FKs
  // (paymentTransactionId->payment_transactions, studentId->student_profiles),
  // CHECKs (amountPaise > 0, currency = 'INR', char_length(reason) >= 1,
  // unreversiblePaise >= 0), RLS, and refunds_guard are raw SQL in the migration.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@unique([razorpayRefundId]) // migration replaces with a partial unique
  @@unique([idempotencyKey]) // request-time correlation key (HIGH-2)
  @@index([institutionId])
  @@index([institutionId, paymentTransactionId])
  @@index([institutionId, status])
  @@map("refunds")
}

model RefundReversal {
  id              String        @id @default(cuid())
  institutionId   String
