generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────

enum UserRole {
  STUDENT
  HOD
  GUARD
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  PENDING_APPROVAL
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum PassStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  OUTSIDE
  COMPLETED
  CANCELLED
  EXPIRED
  REVOKED
}

enum GateEventType {
  EXIT
  RETURN
}

enum AuditAction {
  PASS_REQUESTED
  PASS_APPROVED
  PASS_REJECTED
  PASS_CANCELLED
  PASS_REVOKED
  PASS_EXPIRED
  GATE_EXIT
  GATE_RETURN
  SHIFT_CREATED
  SHIFT_STARTED
  SHIFT_ENDED
  EMERGENCY_DECLARED
  EMERGENCY_RESOLVED
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  USER_REACTIVATED
  GATE_CREATED
  GATE_UPDATED
  DEPARTMENT_CREATED
  DEPARTMENT_UPDATED
  REASON_CREATED
  REASON_UPDATED
  BULK_IMPORT
  EMERGENCY_OVERRIDE
  ALLOWANCE_POLICY_UPDATED
  INSTITUTION_CONFIG_UPDATED
  ACADEMIC_CALENDAR_UPDATED
}

enum AuditResult {
  SUCCESS
  DENIED
  ERROR
}

enum SupportGrantStatus {
  REQUESTED
  ACTIVE
  EXPIRED
  REVOKED
}

enum PolicyPeriod {
  DAILY
  WEEKLY
  MONTHLY
  SEMESTER
}

enum EnforcementMode {
  BLOCK_NEW_REQUESTS
  WARN_ONLY
}

enum SeverityLevel {
  MINOR
  MODERATE
  SIGNIFICANT
  SEVERE
}

enum InstitutionStatus {
  ACTIVE
  SUSPENDED
}

enum ModuleState {
  ENTITLED
  ACTIVE
  SUSPENDED
}

// ─── ACADEMICS (Phase 1 — sessions / terms / programs / calendar) ───────────

enum AcademicSessionStatus {
  UPCOMING
  ACTIVE
  CLOSED
}

enum AcademicStructureType {
  SEMESTER
  TRIMESTER
  ANNUAL
  CUSTOM
}

enum AcademicTermStatus {
  UPCOMING
  ACTIVE
  CLOSED
}

enum ProgramStatus {
  ACTIVE
  INACTIVE
}

enum ProgramDurationUnit {
  TERMS
  YEARS
}

enum WeekStartDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AcademicDayType {
  WORKING_DAY
  HOLIDAY
  WEEKEND
  EXAM_DAY
  VACATION
  SPECIAL_WORKING_DAY
  INSTITUTION_EVENT
}

enum GuardShiftStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EmergencyType {
  FIRE
  EARTHQUAKE
  MEDICAL
  SECURITY
  EVACUATION
  OTHER
}

enum EmergencyStatus {
  ACTIVE
  RESOLVED
}

// ─── INSTITUTION (future multi-tenancy) ─────────────────────────────────────

model Institution {
  id        String            @id @default(cuid())
  name      String
  code      String            @unique
  domain    String?
  status    InstitutionStatus @default(ACTIVE)
  settings  Json              @default("{}")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  departments        Department[]
  gates              Gate[]
  users              User[]
  exitReasons        ExitReason[]
  allowancePolicy    AllowancePolicy?
  institutionConfig  InstitutionConfig?
  academicCalendarDays AcademicCalendarDay[]
  guardShifts          GuardShift[]
  emergencyAlerts      EmergencyAlert[]
  studentProfiles      StudentProfile[]
  hodProfiles          HodProfile[]
  guardProfiles        GuardProfile[]
  gatePasses           GatePass[]
  gateEvents           GateEvent[]
  guardGateAssignments GuardGateAssignment[]
  emergencyOverrides   EmergencyOverride[]
  reliabilitySnapshots ReliabilityScoreSnapshot[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  memberships          InstitutionMembership[]
  roles                Role[]
  auditEvents          AuditEvent[]
  supportGrants        SupportGrant[]
  institutionModules   InstitutionModule[]
  academicSessions             AcademicSession[]
  academicTerms                AcademicTerm[]
  programs                     Program[]
  academicCalendarDayRevisions AcademicCalendarDayRevision[]

  @@map("institutions")
}

// ─── DEPARTMENT ─────────────────────────────────────────────────────────────

model Department {
  id            String      @id @default(cuid())
  name          String
  code          String
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  students StudentProfile[]
  hods     HodProfile[]
  programs            Program[]
  academicCalendarDays AcademicCalendarDay[]

  @@unique([institutionId, code])
  @@unique([id, institutionId])
  @@map("departments")
}

// ─── USER (unified auth) ────────────────────────────────────────────────────

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String?
  googleId      String?       @unique
  role          UserRole
  accountStatus AccountStatus @default(ACTIVE)
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lastLoginAt   DateTime?
  phone            String?
  mfaEnabled       Boolean       @default(false)
  mfaSecret        String?
  mfaRecoveryCodes Json?
  mfaEnrolledAt    DateTime?

  studentProfile StudentProfile?
  hodProfile     HodProfile?
  guardProfile   GuardProfile?

  // Audit trail
  auditLogs          AuditLog[]          @relation("AuditActor")
  emergencyOverrides    EmergencyOverride[] @relation("OverrideActor")
  createdShifts         GuardShift[]        @relation("ShiftCreatedBy")
  createdEmergencyAlerts EmergencyAlert[]   @relation("EmergencyDeclaredBy")
  resolvedEmergencyAlerts EmergencyAlert[]  @relation("EmergencyResolvedBy")
  sessions               Session[]
  securityEvents         SecurityEvent[]
  memberships            InstitutionMembership[]

  // Super Admin & platform security (FEAT-001)
  auditEvents            AuditEvent[]   @relation("AuditEventActor")
  supportGrantsGranted   SupportGrant[] @relation("SupportGrantGrantee")
  supportGrantsRevoked   SupportGrant[] @relation("SupportGrantRevoker")

  @@unique([id, institutionId])
  @@map("users")
}

// ─── IDENTITY & RBAC (B-2) ──────────────────────────────────────────────────

model InstitutionMembership {
  id                 String           @id @default(cuid())
  userId             String
  institutionId      String
  membershipStatus   MembershipStatus @default(ACTIVE)
  departmentScope    String?
  permissionsVersion Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id])
  institution Institution      @relation(fields: [institutionId], references: [id])
  roles       MembershipRole[]

  @@unique([userId, institutionId])
  @@unique([id, institutionId])
  @@index([institutionId])
  @@index([userId])
  @@map("institution_memberships")
}

model Role {
  id            String           @id @default(cuid())
  key           String
  name          String
  institutionId String?
  institution   Institution?     @relation(fields: [institutionId], references: [id])
  permissions   RolePermission[]
  memberships   MembershipRole[]

  @@unique([key, institutionId])
  @@index([institutionId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  module      String
  description String
  roleLinks   RolePermission[]

  @@index([module])
  @@map("permissions")
}

model MembershipRole {
  id            String                @id @default(cuid())
  membershipId  String
  roleId        String
  institutionId String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  membership InstitutionMembership @relation(fields: [membershipId], references: [id])
  role       Role                  @relation(fields: [roleId], references: [id])

  @@unique([membershipId, roleId])
  @@index([institutionId])
  @@map("membership_roles")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ─── STUDENT PROFILE ────────────────────────────────────────────────────────

model StudentProfile {
  id            String      @id @default(cuid())
  userId        String      @unique
  user          User        @relation(fields: [userId], references: [id])
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  enrollmentNo  String      @unique
  rollNumber    String?
  name          String
  departmentId  String
  department    Department  @relation(fields: [departmentId], references: [id])
  program       String
  semester      Int
  section       String?
  dob           String?
  phone         String?
  address       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  gatePasses           GatePass[]
  reliabilitySnapshots ReliabilityScoreSnapshot[]

  @@unique([id, institutionId])
  @@index([institutionId])
  @@map("student_profiles")
}

// ─── HOD PROFILE ────────────────────────────────────────────────────────────

model HodProfile {
  id            String      @id @default(cuid())
  userId        String      @unique
  user          User        @relation(fields: [userId], references: [id])
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  name          String
  departmentId  String
  department    Department  @relation(fields: [departmentId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  approvedPasses GatePass[] @relation("ApprovedBy")

  @@unique([id, institutionId])
  @@index([institutionId])
  @@map("hod_profiles")
}

// ─── GUARD PROFILE ──────────────────────────────────────────────────────────

model GuardProfile {
  id            String      @id @default(cuid())
  userId        String      @unique
  user          User        @relation(fields: [userId], references: [id])
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  name          String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  assignedGates GuardGateAssignment[]
  gateEvents    GateEvent[]
  shifts        GuardShift[]

  @@unique([id, institutionId])
  @@index([institutionId])
  @@map("guard_profiles")
}

// ─── GATE ───────────────────────────────────────────────────────────────────

model Gate {
  id            String      @id @default(cuid())
  name          String
  location      String?
  isActive      Boolean     @default(true)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  assignedGuards GuardGateAssignment[]
  gateEvents     GateEvent[]
  shifts         GuardShift[]

  @@unique([institutionId, name])
  @@unique([id, institutionId])
  @@map("gates")
}

// ─── GUARD ↔ GATE (many-to-many) ───────────────────────────────────────────

model GuardGateAssignment {
  id            String       @id @default(cuid())
  guardId       String
  guard         GuardProfile @relation(fields: [guardId], references: [id])
  gateId        String
  gate          Gate         @relation(fields: [gateId], references: [id])
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id])
  createdAt     DateTime     @default(now())

  @@unique([guardId, gateId])
  @@index([institutionId])
  @@map("guard_gate_assignments")
}

// ─── EXIT REASONS (configurable) ────────────────────────────────────────────

model ExitReason {
  id            String      @id @default(cuid())
  label         String
  requiresNote  Boolean     @default(false)
  isActive      Boolean     @default(true)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  gatePasses GatePass[]

  @@unique([id, institutionId])
  @@map("exit_reasons")
}

// ─── GATE PASS (core entity) ────────────────────────────────────────────────

model GatePass {
  id             String         @id @default(cuid())
  passNumber     String         @unique
  institutionId  String
  institution    Institution    @relation(fields: [institutionId], references: [id])
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id])
  reasonId       String
  reason         ExitReason     @relation(fields: [reasonId], references: [id])
  customReason   String?
  requestedExit  DateTime
  expectedReturn DateTime
  status         PassStatus     @default(PENDING)

  // Approval
  approvedById    String?
  approvedBy      HodProfile? @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?

  // QR token
  qrToken     String?   @unique
  qrExpiresAt DateTime?

  // Actual times
  actualExit     DateTime?
  actualReturn   DateTime?
  overdueMinutes Int?

  // Allowance warning (set when pass created under warn_only with exhausted allowance)
  allowanceWarning String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gateEvents        GateEvent[]
  emergencyOverride EmergencyOverride?

  @@unique([id, institutionId])
  @@index([studentId, status])
  @@index([status, createdAt])
  @@index([institutionId])
  @@map("gate_passes")
}

// ─── GATE EVENTS ────────────────────────────────────────────────────────────

model GateEvent {
  id            String        @id @default(cuid())
  passId        String
  pass          GatePass      @relation(fields: [passId], references: [id])
  gateId        String
  gate          Gate          @relation(fields: [gateId], references: [id])
  guardId       String
  guard         GuardProfile  @relation(fields: [guardId], references: [id])
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id])
  eventType     GateEventType
  timestamp     DateTime      @default(now())
  method        String        @default("QR_SCAN")

  @@index([passId, eventType])
  @@index([institutionId])
  @@map("gate_events")
}

// ─── GUARD SHIFTS ───────────────────────────────────────────────────────────

model GuardShift {
  id               String           @id @default(cuid())
  institutionId    String
  institution      Institution      @relation(fields: [institutionId], references: [id])
  guardId          String
  guard            GuardProfile     @relation(fields: [guardId], references: [id])
  gateId           String
  gate             Gate             @relation(fields: [gateId], references: [id])
  status           GuardShiftStatus @default(SCHEDULED)
  scheduledStartAt DateTime
  scheduledEndAt   DateTime
  actualStartAt    DateTime?
  actualEndAt      DateTime?
  note             String?
  createdById      String?
  createdBy        User?            @relation("ShiftCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([institutionId, scheduledStartAt])
  @@index([guardId, status])
  @@index([gateId, status])
  @@map("guard_shifts")
}

// ─── AUDIT LOG ──────────────────────────────────────────────────────────────

model AuditLog {
  id            String      @id @default(cuid())
  actorId       String
  actor         User        @relation("AuditActor", fields: [actorId], references: [id])
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  action        AuditAction
  targetId      String?
  targetType    String?
  metadata      Json?
  timestamp     DateTime    @default(now())

  @@index([actorId, timestamp])
  @@index([action, timestamp])
  @@index([institutionId])
  @@map("audit_logs")
}

// ─── AUDIT EVENT v2 (Super Admin & platform security, FEAT-001) ─────────────
// Generic string-keyed audit table (action validated against the shared
// catalogue, not a pg enum) with a NULLABLE institutionId for platform actions.
// Single-column FKs: the actor can be a platform user with no membership and
// rows may precede/cross tenant context, so no composite tenant FK here.
model AuditEvent {
  id                String        @id @default(cuid())
  institutionId     String?
  institution       Institution?  @relation(fields: [institutionId], references: [id])
  actorUserId       String
  actorUser         User          @relation("AuditEventActor", fields: [actorUserId], references: [id])
  actorMembershipId String?
  actorRoleKey      String
  action            String
  resourceType      String
  resourceId        String?
  result            AuditResult
  supportGrantId    String?
  supportGrant      SupportGrant? @relation(fields: [supportGrantId], references: [id])
  requestRef        String?
  metadata          Json?
  timestamp         DateTime      @default(now())

  @@index([institutionId, timestamp])
  @@index([actorUserId, timestamp])
  @@index([action, timestamp])
  @@index([supportGrantId])
  @@map("audit_events")
}

// ─── SUPPORT GRANT (break-glass, FEAT-001) ──────────────────────────────────
// PLATFORM-owned, single-tenant, purpose-bound, time-limited, revocable,
// tenant-visible, fully audited break-glass authorization record.
model SupportGrant {
  id              String             @id @default(cuid())
  institutionId   String
  institution     Institution        @relation(fields: [institutionId], references: [id])
  grantedToUserId String
  grantedToUser   User               @relation("SupportGrantGrantee", fields: [grantedToUserId], references: [id])
  purpose         String
  scope           Json?
  status          SupportGrantStatus @default(REQUESTED)
  requestedAt     DateTime           @default(now())
  activatedAt     DateTime?
  expiresAt       DateTime
  revokedAt       DateTime?
  revokedByUserId String?
  revokedByUser   User?              @relation("SupportGrantRevoker", fields: [revokedByUserId], references: [id])
  revokedReason   String?
  createdAt       DateTime           @default(now())

  auditEvents     AuditEvent[]

  @@index([institutionId, status])
  @@index([grantedToUserId, status])
  @@map("support_grants")
}

// ─── MODULE ENTITLEMENT / ACTIVATION (CAMPASS booster model, architecture.md §5) ─
// TENANT-OWNED lifecycle row for one (institution, module) pair. The four states
// in architecture.md §5.2 are NOT_ENTITLED -> ENTITLED -> ACTIVE <-> SUSPENDED;
// NOT_ENTITLED is modelled as the ABSENCE of a row, so the enum holds only the
// three states a row can be in. Platform grants/revokes entitlement (privileged
// path); the tenant admin activates/suspends under RLS. who/when fields carry
// actor ids only (no composite FK — a platform actor has no membership in this
// tenant, mirroring AuditEvent.actorUserId).
model InstitutionModule {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  moduleKey     String // validated against MODULE_KEYS in @campusgate/shared
  state         ModuleState @default(ENTITLED)

  entitledAt  DateTime  @default(now())
  activatedAt DateTime?
  suspendedAt DateTime?

  settings Json? // optional per-institution module config (future required-config hook)

  entitledByUserId  String?
  activatedByUserId String?
  suspendedByUserId String?
  updatedAt         DateTime @updatedAt

  @@unique([institutionId, moduleKey])
  @@unique([id, institutionId])
  @@index([institutionId])
  @@map("institution_modules")
}

// ─── ACADEMIC SESSION / TERM (Phase 1, tenant-owned) ────────────────────────

model AcademicSession {
  id            String                @id @default(cuid())
  institutionId String
  institution   Institution           @relation(fields: [institutionId], references: [id])
  name          String
  structureType AcademicStructureType
  status        AcademicSessionStatus @default(UPCOMING)
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  terms                AcademicTerm[]
  calendarDays         AcademicCalendarDay[]
  calendarDayRevisions AcademicCalendarDayRevision[]

  @@unique([institutionId, name])
  @@unique([id, institutionId])
  @@index([institutionId])
  @@index([institutionId, status])
  @@map("academic_sessions")
}

model AcademicTerm {
  id                String             @id @default(cuid())
  institutionId     String
  institution       Institution        @relation(fields: [institutionId], references: [id])
  academicSessionId String
  academicSession   AcademicSession    @relation(fields: [academicSessionId], references: [id])
  name              String
  ordinal           Int
  status            AcademicTermStatus @default(UPCOMING)
  startDate         DateTime
  endDate           DateTime
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  calendarDays         AcademicCalendarDay[]
  calendarDayRevisions AcademicCalendarDayRevision[]

  @@unique([academicSessionId, ordinal])
  @@unique([id, institutionId])
  @@index([institutionId])
  @@index([academicSessionId])
  @@map("academic_terms")
}

// ─── PROGRAM (Phase 1, tenant-owned) ────────────────────────────────────────

model Program {
  id            String              @id @default(cuid())
  institutionId String
  institution   Institution         @relation(fields: [institutionId], references: [id])
  departmentId  String
  department    Department          @relation(fields: [departmentId], references: [id])
  name          String
  code          String
  duration      Int
  durationUnit  ProgramDurationUnit @default(TERMS)
  status        ProgramStatus       @default(ACTIVE)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([institutionId, code])
  @@unique([id, institutionId])
  @@index([institutionId])
  @@index([departmentId])
  @@map("programs")
}

// ─── ACADEMIC CALENDAR DAY REVISION (Phase 1, tenant-owned, append-only) ────

model AcademicCalendarDayRevision {
  id                String           @id @default(cuid())
  institutionId     String
  institution       Institution      @relation(fields: [institutionId], references: [id])
  calendarDayId     String?
  date              DateTime
  departmentId      String?
  previousDayType   AcademicDayType?
  newDayType        AcademicDayType?
  previousNote      String?
  newNote           String?
  changeType        String
  actorUserId       String
  academicSessionId String?
  academicSession   AcademicSession? @relation(fields: [academicSessionId], references: [id])
  academicTermId    String?
  academicTerm      AcademicTerm?    @relation(fields: [academicTermId], references: [id])
  createdAt         DateTime         @default(now())

  @@unique([id, institutionId])
  @@index([institutionId])
  @@index([institutionId, date])
  @@index([calendarDayId])
  @@map("academic_calendar_day_revisions")
}

// ─── NOTIFICATIONS ──────────────────────────────────────────────────────────

model Notification {
  id            String      @id @default(cuid())
  userId        String
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  title         String
  body          String
  type          String
  data          Json?
  read          Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([userId, read, createdAt])
  @@index([institutionId])
  @@map("notifications")
}

// ─── ALLOWANCE POLICY ───────────────────────────────────────────────────────

model InstitutionConfig {
  id                           String       @id @default(cuid())
  institutionId                String       @unique
  institution                  Institution  @relation(fields: [institutionId], references: [id])
  timezone                     String       @default("Asia/Kolkata")
  weekStartDay                 WeekStartDay @default(MONDAY)
  workingDaysOfWeek            Json         @default("[1,2,3,4,5,6]")
  lowAllowanceThresholdMinutes Int          @default(60)
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt

  @@map("institution_configs")
}

model AcademicCalendarDay {
  id            String          @id @default(cuid())
  institutionId String
  institution   Institution     @relation(fields: [institutionId], references: [id])
  date          DateTime
  dayType       AcademicDayType
  note          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Phase 1 generalization (all nullable; existing rows stay valid).
  departmentId      String?
  department        Department?      @relation(fields: [departmentId], references: [id])
  academicSessionId String?
  academicSession   AcademicSession? @relation(fields: [academicSessionId], references: [id])
  academicTermId    String?
  academicTerm      AcademicTerm?    @relation(fields: [academicTermId], references: [id])

  @@index([institutionId, date])
  @@map("academic_calendar_days")
}

model AllowancePolicy {
  id                     String          @id @default(cuid())
  institutionId          String          @unique
  institution            Institution     @relation(fields: [institutionId], references: [id])
  allowanceAmount        Int             @default(1440) // minutes, [60, 10080]
  policyPeriod           PolicyPeriod    @default(WEEKLY)
  gracePeriod            Int             @default(10) // minutes, [0, 60]
  enforcement            EnforcementMode @default(WARN_ONLY)
  minimumSampleSize      Int             @default(5) // [3, 20]
  severityMinorMax       Int             @default(15)
  severityModerateMax    Int             @default(60)
  severitySignificantMax Int             @default(180)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@map("allowance_policies")
}

// ─── EMERGENCY OVERRIDE ─────────────────────────────────────────────────────

model EmergencyOverride {
  id             String      @id @default(cuid())
  gatePassId     String      @unique
  gatePass       GatePass    @relation(fields: [gatePassId], references: [id])
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id])
  overriddenById String
  overriddenBy   User        @relation("OverrideActor", fields: [overriddenById], references: [id])
  justification  String // min 10 characters
  createdAt      DateTime    @default(now())

  @@index([institutionId])
  @@map("emergency_overrides")
}

model EmergencyAlert {
  id             String          @id @default(cuid())
  institutionId  String
  institution    Institution     @relation(fields: [institutionId], references: [id])
  type           EmergencyType
  status         EmergencyStatus @default(ACTIVE)
  title          String
  message        String
  affectedArea   String?
  declaredById   String
  declaredBy     User            @relation("EmergencyDeclaredBy", fields: [declaredById], references: [id])
  declaredAt     DateTime        @default(now())
  resolvedById   String?
  resolvedBy     User?           @relation("EmergencyResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([institutionId, status, declaredAt])
  @@map("emergency_alerts")
}

// ─── RELIABILITY SCORE SNAPSHOT ─────────────────────────────────────────────

model ReliabilityScoreSnapshot {
  id             String         @id @default(cuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id])
  institutionId  String
  institution    Institution    @relation(fields: [institutionId], references: [id])
  score          Float // 0.0–5.0
  movementNumber Int // sequential movement count at time of snapshot
  computedAt     DateTime       @default(now())

  @@index([studentId, computedAt])
  @@index([institutionId])
  @@map("reliability_score_snapshots")
}

// ─── SESSION & DEVICE SECURITY ──────────────────────────────────────────────

model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Stores the JWT jti claim — revoke by marking this row revoked
  jti          String    @unique
  deviceName   String?
  deviceType   String?   // "desktop" | "mobile" | "tablet"
  browser      String?
  os           String?
  ipAddress    String?
  revoked      Boolean   @default(false)
  revokedAt    DateTime?
  revokedReason String?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime

  @@index([userId, revoked])
  @@index([jti])
  @@map("sessions")
}

model SecurityEvent {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  institutionId String?
  eventType     SecurityEventType
  ipAddress     String?
  deviceInfo    String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([institutionId, eventType, createdAt])
  @@map("security_events")
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  SESSION_REVOKED
  SESSION_EXPIRED
  PASSWORD_CHANGED
  SUSPICIOUS_ACTIVITY
  ACCOUNT_LOCKED
  NEW_DEVICE_LOGIN
}
