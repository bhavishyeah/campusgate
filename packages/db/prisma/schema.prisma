}

model EmergencyAlert {
  id             String          @id @default(cuid())
  institutionId  String
  institution    Institution     @relation(fields: [institutionId], references: [id])
  type           EmergencyType
  status         EmergencyStatus @default(ACTIVE)
  title          String
