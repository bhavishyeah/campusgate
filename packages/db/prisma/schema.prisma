  @@index([institutionId])
  @@index([institutionId, marksRecordId])
  @@map("marks_record_history")
}

model ResultPublication {
  id                String                  @id @default(cuid())
  institutionId     String
  institution       Institution             @relation(fields: [institutionId], references: [id])
  examId            String
  exam              Examination             @relation(fields: [examId], references: [id])
  version           Int // 1,2,3... per (institutionId, examId)
  status            ResultPublicationStatus @default(PUBLISHED)
  gradingSchemeId   String
  gradingScheme     GradingScheme           @relation(fields: [gradingSchemeId], references: [id])
  publishedByUserId String // recorded actor id (no FK)
  reason            String? // required on version > 1 (service-enforced)
  publishedAt       DateTime                @default(now())
  createdAt         DateTime                @default(now())

  snapshots      ResultSnapshot[]
  reevalRequests ReevalRequest[] @relation("ReevalSourcePublication")

  // Slice 8.2: immutability moves from an unconditional append-only trigger to a
  // COLUMN-GUARD (result_publications_guard) that permits EXACTLY PUBLISHED->
  // SUPERSEDED and forbids every other mutation + all DELETEs (raw SQL, migration
  // ┬ºm). The RLS pair becomes the default {tenant_isolation_select,
  // tenant_isolation_modify} and campass_app gains GRANT UPDATE. Composite
  // same-tenant FKs ((institutionId, examId)->examinations, (institutionId,
  // gradingSchemeId)->grading_schemes), the (institutionId, examId, version)
  // unique, and CHECK version >= 1 are raw SQL in the migration.
  @@unique([id, institutionId]) // anchors composite same-tenant FKs
  @@unique([institutionId, examId, version]) // hard monotonic version key
  @@index([institutionId])
  @@index([institutionId, examId])
  @@map("result_publications")
}

