# ─── Database (Supabase Postgres) ────────────────────────────────────────────
# Two connection strings are required:
#
#   DATABASE_URL  Pooled (Supavisor transaction mode, port 6543) — used by the app
#                 at runtime. MUST include ?pgbouncer=true because transaction mode
#                 does not support prepared statements (Prisma would otherwise fail).
#   DIRECT_URL    Migrations / DDL. Prefer the Direct connection (port 5432 at
#                 db.<ref>.supabase.co). That host is IPv6-only; if your network
#                 can't reach it, use the Session pooler instead: same pooler host
#                 as DATABASE_URL but port 5432 (IPv4), as shown below.
#
# Get both from: Supabase Dashboard → Connect. Fill in your real password.

DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct host (IPv6): postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Session pooler (IPv4 fallback, used here):
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
