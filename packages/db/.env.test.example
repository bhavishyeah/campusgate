# ─── LIVE-DB TEST PROJECT settings (packages/db/.env.test) ───────────────────────
# Copy to packages/db/.env.test (git-ignored) and fill from the dedicated TEST
# Supabase project: Dashboard > Connect. NEVER put the production project here.
# Used by the live suites (as the owner/admin connection) and by
# `npm run db:migrate:test`. Setup guide: docs/test-database.md
#
# DIRECT_URL    The `postgres` owner role over the SESSION pooler (port 5432).
#               Used for migrations and as the suites' admin/owner connection.
#               Supavisor login username format: postgres.<test-project-ref>
DIRECT_URL="postgresql://postgres.<test-project-ref>:<postgres-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# DATABASE_URL  Prisma's schema requires it. Transaction pooler (6543) with
#               ?pgbouncer=true, same project as DIRECT_URL.
DATABASE_URL="postgresql://postgres.<test-project-ref>:<postgres-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# PRIVILEGED_DATABASE_URL  Optional and currently informational: the live suites pin
# the privileged client to DIRECT_URL (as they always did). If set it is still
# checked by the production guard.
# PRIVILEGED_DATABASE_URL="postgresql://postgres.<test-project-ref>:<postgres-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
