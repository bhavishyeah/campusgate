# API origin used for BOTH REST calls and the WebSocket connection.
# The WS server shares this host (the API serves /ws/connect), so the WS URL is
# derived from this value by default: http:// -> ws://, https:// -> wss://.
NEXT_PUBLIC_API_URL=http://localhost:4000

# OPTIONAL WebSocket override. Same host as the API in nearly all setups; set it
# ONLY when the WS host genuinely differs from NEXT_PUBLIC_API_URL. Leave it
# unset (or empty) to derive the WS URL from NEXT_PUBLIC_API_URL above.
# Example: NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_WS_URL=
